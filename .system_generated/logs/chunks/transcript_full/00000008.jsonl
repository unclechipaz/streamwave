n41:     \"benefits\": [\n42:         \"Full Zimbabwean catalogue access\",\n43:         \"5-second MP4 movie previews\",\n44:         \"Demonstration music audio samples\",\n45:         \"Access on desktop or mobile\",\n46:     ],\n47: }\n48: \n49: # Session Cookie Signing Secret\n50: DEMO_SESSION_SECRET = os.getenv(\n51:     \"DEMO_SESSION_SECRET\", \"streamwave-secret-key-academic-demo-2026\"\n52: ).encode(\"utf-8\")\n53: \n54: \n55: def create_session_token(email: str, expiry_seconds: int = 86400 * 7) -> str:\n56:     \"\"\"Generates an HMAC-SHA256 signed session token for a paid demonstration member.\"\"\"\n57:     payload = {\n58:         \"email\": email.strip().lower(),\n59:         \"plan_id\": SUBSCRIPTION_PLAN[\"id\"],\n60:         \"exp\": int(time.time()) + expiry_seconds,\n61:     }\n62:     json_bytes = json.dumps(payload, separators=(\",\", \":\")).encode(\"utf-8\")\n63:     b64_payload = base64.urlsafe_b64encode(json_bytes).decode(\"utf-8\").rstrip(\"=\")\n64: \n65:     signature = hmac.new(DEMO_SESSION_SECRET, b64_payload.encode(\"utf-8\"), hashlib.sha256).hexdigest()\n66:     return f\"{b64_payload}.{signature}\"\n67: \n68: \n69: def verify_session_token(token: str) -> Optional[dict]:\n70:     \"\"\"Verifies and decodes an HMAC-SHA256 signed session token.\"\"\"\n71:     if not token or \".\" not in token:\n72:         return None\n73:     try:\n74:         b64_payload, signature = token.rsplit(\".\", 1)\n75:         expected_sig = hmac.new(DEMO_SESSION_SECRET, b64_payload.encode(\"utf-8\"), hashlib.sha256).hexdigest()\n76:         if not hmac.compare_digest(expected_sig, signature):\n77:             return None\n78: \n79:         # Add padding back if necessary\n80:         padded_b64 = b64_payload + \"=\" * (-len(b64_payload) % 4)\n81:         payload_bytes = base64.urlsafe_b64decode(padded_b64.encode(\"utf-8\"))\n82:         payload = json.loads(payload_bytes.decode(\"utf-8\"))\n83: \n84:         if payload.get(\"exp\", 0) < time.time():\n85:             return None\n86:         return payload\n87:     except Exception as e:\n88:         logger.warning(f\"Session token verification error: {e}\")\n89:         return None\n90: \n91: \n92: # --- Asset Initialization Helpers ---\n93: \n94: def ensure_video_preview_asset():\n95:     MEDIA_DIR.mkdir(parents=True, exist_ok=True)\n96:     if not PREVIEW_VIDEO_FILE.exists() or PREVIEW_VIDEO_FILE.stat().st_size == 0:\n97:         downloads_dir = Path(r\"C:\\Users\\dell\\Downloads\")\n98:         candidate_sources = [\n99:             downloads_dir / \"Use_the_uploaded_StreamWave_lo.mp4\",\n100:             downloads_dir / \"Download (28).mp4\",\n101:         ]\n102:         for src in candidate_sources:\n103:             if src.exists() and src.stat().st_size > 0:\n104:                 try:\n105:                     shutil.copyfile(src, PREVIEW_VIDEO_FILE)\n106:                     logger.info(f\"Copied StreamWave preview MP4 video from {src} to {PREVIEW_VIDEO_FILE}\")\n107:                     break\n108:                 except Exception as e:\n109:                     logger.error(f\"Failed to copy video asset from {src}: {e}\")\n110: \n111: \n112: def ensure_logo_asset():\n113:     IMAGES_DIR.mkdir(parents=True, exist_ok=True)\n114:     if not LOGO_IMAGE_FILE.exists() or LOGO_IMAGE_FILE.stat().st_size == 0:\n115:         src = BASE_DIR / \".user_uploaded\" / \"media_1787682860034.png\"\n116:         if not src.exists():\n117:             src = BASE_DIR / \".user_uploaded\" / \"media_1787683482860.png\"\n118:         if src.exists() and src.stat().st_size > 0:\n119:             try:\n120:                 shutil.copyfile(src, LOGO_IMAGE_FILE)\n121:                 logger.info(f\"Copied StreamWave logo image from {src} to {LOGO_IMAGE_FILE}\")\n122:             except Exception as e:\n123:                 logger.error(f\"Failed to copy logo image: {e}\")\n124: \n125: \n126: def ensure_favicon_assets():\n127:     if LOGO_IMAGE_FILE.exists():\n128:         favicon_png = IMAGES_DIR / \"favicon.png\"\n129:         favicon_ico = PUBLIC_DIR / \"favicon.ico\"\n130:         try:\n131:             if not favicon_png.exists():\n132:                 shutil.copyfile(LOGO_IMAGE_FILE, favicon_png)\n133:             if not favicon_ico.exists():\n134:                 shutil.copyfile(LOGO_IMAGE_FILE, favicon_ico)\n135:         except Exception as e:\n136:             logger.error(f\"Failed to copy favicon: {e}\")\n137: \n138: \n139: ensure_video_preview_asset()\n140: ensure_logo_asset()\n141: ensure_favicon_assets()\n142: \n143: # Vercel Blob Audio URL Environment Variable with local static fallback\n144: DEFAULT_FALLBACK_AUDIO_URL = \"/media/demo.wav\"\n145: BLOB_AUDIO_URL_ENV = os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\")\n146: \n147: \n148: def load_media_catalogue() -> List[dict]:\n149:     \"\"\"Loads read-only media catalogue from data/media.json using pathlib.\"\"\"\n150:     if not DATA_FILE.exists():\n151:         logger.error(f\"Media catalogue file not found at {DATA_FILE}\")\n152:         return []\n153: \n154:     with open(DATA_FILE, \"r\", encoding=\"utf-8\") as f:\n155:         catalogue = json.load(f)\n156: \n157:     active_blob_url = os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\")\n158: \n159:     for item in catalogue:\n160:         if item.get(\"type\") == \"music\" and item.get(\"media_url\") == DEFAULT_FALLBACK_AUDIO_URL and active_blob_url:\n161:             item[\"media_url\"] = active_blob_url.strip()\n162: \n163:     return catalogue\n164: \n165: \n166: # --- FastAPI Dependency for Access Control ---\n167: \n168: async def verify_paid_session(request: Request) -> dict:\n169:     \"\"\"FastAPI reusable dependency enforcing signed demo-paid session cookie for protected catalogue APIs.\"\"\"\n170:     token = request.cookies.get(\"streamwave_session\")\n171:     session_data = verify_session_token(token) if token else None\n172:     if not session_data:\n173:         raise HTTPException(\n174:             status_code=status.HTTP_401_UNAUTHORIZED,\n175:             detail=\"Membership required. Please subscribe to access the StreamWave catalogue.\",\n176:         )\n177:     return session_data\n178: \n179: \n180: # --- Pydantic Validation Models ---\n181: \n182: class HealthResponse(BaseModel):\n183:     status: str = Field(..., json_schema_extra={\"example\": \"ok\"})\n184:     platform: str = Field(..., json_schema_extra={\"example\": \"StreamWave Serverless Media Platform\"})\n185:     environment: str = Field(..., json_schema_extra={\"example\": \"Vercel Serverless\"})\n186:     blob_storage_configured: bool = Field(..., json_schema_extra={\"example\": False})\n187:     timestamp: str = Field(..., json_schema_extra={\"example\": \"2026-08-25T17:25:30Z\"})\n188: \n189: \n190: class MediaItem(BaseModel):\n191:     id: str = Field(..., json_schema_extra={\"example\": \"1\"})\n192:     title: str = Field(..., json_schema_extra={\"example\": \"Cook Off\"})\n193:     artist_or_director: str = Field(..., json_schema_extra={\"example\": \"Tomas Brickhill\"})\n194:     type: str = Field(..., json_schema_extra={\"example\": \"movie\"})\n195:     genre: str = Field(..., json_schema_extra={\"example\": \"Comedy\"})\n196:     year: int = Field(..., json_schema_extra={\"example\": 2017})\n197:     duration: str = Field(..., json_schema_extra={\"example\": \"1h 41m\"})\n198:     description: str = Field(...)\n199:     cover_image: Optional[str] = None\n200:     media_url: Optional[str] = None\n201:     preview_url: Optional[str] = None\n202: \n203: \n204: class PlayEventRequest(BaseModel):\n205:     media_id: str = Field(..., min_length=1, max_length=50)\n206:     session_id: Optional[str] = Field(default=None, max_length=100)\n207:     client_timestamp: Optional[str] = Field(default=None, max_length=100)\n208: \n209: \n210: class PlayEventDetail(BaseModel):\n211:     media_id: str\n212:     session_id: Optional[str] = None\n213:     client_timestamp: Optional[str] = None\n214:     server_timestamp: str\n215:     media_title: str\n216:     media_url_used: Optional[str] = None\n217: \n218: \n219: class PlayEventResponse(BaseModel):\n220:     status: str = \"recorded\"\n2