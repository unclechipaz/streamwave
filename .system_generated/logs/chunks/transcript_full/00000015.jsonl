not enter genuine payment information.</p>\n                </div>\n            </div>\n\n            <div class=\"checkout-grid\">\n                <!-- Subscription Summary Box -->\n                <div class=\"summary-box\">\n                    <h2 class=\"box-title\">Order Summary</h2>\n                    <div class=\"plan-card\">\n                        <div class=\"plan-header\">\n                            <span class=\"plan-badge\">STUDENT DEMO PLAN</span>\n                            <h3 class=\"plan-name\" id=\"summary-plan-name\">StreamWave Monthly</h3>\n                        </div>\n                        <div class=\"plan-price\" id=\"summary-plan-price\">US$2.99 <span class=\"price-period\">/ month</span></div>\n                        <ul class=\"plan-benefits-list\">\n                            <li><span class=\"check-icon\">✓</span> Full Zimbabwean movie & music catalogue</li>\n                            <li><span class=\"check-icon\">✓</span> 5-second MP4 movie video previews</li>\n                            <li><span class=\"check-icon\">✓</span> High-fidelity demonstration audio samples</li>\n                            <li><span class=\"check-icon\">✓</span> Cancel anytime online</li>\n                        </ul>\n                    </div>\n                </div>\n\n                <!-- Payment Method Form Box -->\n                <div class=\"payment-form-box\">\n                    <h2 class=\"box-title\">Select Payment Option</h2>\n\n                    <form id=\"checkout-form\" onsubmit=\"handlePaymentSubmit(event, false)\">\n                        <!-- Customer Email Input -->\n                        <div class=\"form-group\">\n                            <label for=\"checkout-email\" class=\"form-label\">Account Email Address</label>\n                            <input type=\"email\" id=\"checkout-email\" class=\"form-input\" placeholder=\"name@example.co.zw\" required aria-required=\"true\">\n                        </div>\n\n                        <!-- Keyboard Accessible Payment Method Tabs -->\n                        <div class=\"method-tabs\" role=\"tablist\" aria-label=\"Selectable payment method choices\">\n                            <button type=\"button\" class=\"method-tab active\" data-method=\"ecocash\" role=\"tab\" aria-selected=\"true\" aria-controls=\"interface-ecocash\" onclick=\"selectMethod('ecocash')\">\n                                <span class=\"method-icon\" aria-hidden=\"true\">📱</span> EcoCash\n                            </button>\n                            <button type=\"button\" class=\"method-tab\" data-method=\"visa\" role=\"tab\" aria-selected=\"false\" aria-controls=\"interface-visa\" onclick=\"selectMethod('visa')\">\n                                <span class=\"method-icon\" aria-hidden=\"true\">💳</span> Visa\n                            </button>\n                            <button type=\"button\" class=\"method-tab\" data-method=\"mastercard\" role=\"tab\" aria-selected=\"false\" aria-controls=\"interface-mastercard\" onclick=\"selectMethod('mastercard')\">\n                                <span class=\"method-icon\" aria-hidden=\"true\">💳</span> MasterCard\n                            </button>\n                        </div>\n\n                        <!-- EcoCash Interface Container (Only shown when EcoCash selected) -->\n                        <div id=\"interface-ecocash\" class=\"method-interface\" role=\"tabpanel\">\n                            <div class=\"interface-box\">\n                                <span class=\"demo-tag\">Demonstration Mobile Prompt</span>\n                                <label for=\"ecocash-number\" class=\"form-label\">Demonstration Mobile Number</label>\n                                <input type=\"text\" id=\"ecocash-number\" class=\"form-input\" value=\"077 000 0000\" readonly aria-readonly=\"true\">\n                                <div class=\"step-sequence-list\" id=\"ecocash-steps\">\n                                    <div class=\"step-item\"><span class=\"step-bullet\">1</span> USSD payment request sent to mobile handset</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">2</span> Waiting for simulated handset PIN approval</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">3</span> Transaction verified and approved</div>\n                                </div>\n                                <p class=\"help-text\">Simulated EcoCash USSD push request will be dispatched to this test mobile number.</p>\n                            </div>\n                        </div>\n\n                        <!-- Visa Interface Container (Only shown when Visa selected) -->\n                        <div id=\"interface-visa\" class=\"method-interface\" role=\"tabpanel\" style=\"display: none;\">\n                            <div class=\"interface-box\">\n                                <span class=\"demo-tag\">Demonstration Card Interface</span>\n                                <div class=\"test-card-preview\">\n                                    <div class=\"card-chip\" aria-hidden=\"true\"></div>\n                                    <div class=\"card-number-display\">•••• •••• •••• 4242</div>\n                                    <div class=\"card-details-row\">\n                                        <span>DEMO HOLDER</span>\n                                        <span>12/28</span>\n                                    </div>\n                                </div>\n                                <div class=\"step-sequence-list\" id=\"visa-steps\">\n                                    <div class=\"step-item\"><span class=\"step-bullet\">1</span> Validating demonstration test card credentials</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">2</span> Authorizing simulated gateway transaction</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">3</span> Payment verified and approved</div>\n                                </div>\n                                <p class=\"help-text\">Predefined test Visa card (ending in 4242). No CVV or real credentials required.</p>\n                            </div>\n                        </div>\n\n                        <!-- MasterCard Interface Container (Only shown when MasterCard selected) -->\n                        <div id=\"interface-mastercard\" class=\"method-interface\" role=\"tabpanel\" style=\"display: none;\">\n                            <div class=\"interface-box\">\n                                <span class=\"demo-tag\">Demonstration Card Interface</span>\n                                <div class=\"test-card-preview mastercard-theme\">\n                                    <div class=\"card-chip\" aria-hidden=\"true\"></div>\n                                    <div class=\"card-number-display\">•••• •••• •••• 4444</div>\n                                    <div class=\"card-details-row\">\n                                        <span>DEMO HOLDER</span>\n                                        <span>12/28</span>\n                                    </div>\n                                </div>\n                                <div class=\"step-sequence-list\" id=\"mastercard-steps\">\n                                    <div class=\"step-item\"><span class=\"step-bullet\">1</span> Validating demonstration test card credentials</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">2</span> Authorizing simulated gateway transaction</div>\n                                    <div class=\"step-item\"><span class=\"step-bullet\">3</span> Payment verified and approved</div>\n                                </div>\n                                <p class=\"help-text\">Predefined test MasterCard (ending in 4444). No CVV or real credentials required.</p>\n                            </div>\n                        </div>\n\n                        <!-- ARIA Live Status Overlay for Screen Readers & Visual Feedback -->\n                        <div id=\"simulation-status\" class=\"simulation-status-box\" role=\"status\" aria-live=\"polite\" style=\"display: none;\">\n                            <div class=\"status-spinner\" id=\"status-spinner\"></div>\n                            <div id=\"simulation-step-text\" class=\"simulation-step-text\">Initiating simulated authorization...</div>\n                            <div class=\"progress-bar-track\" id=\"progress-bar-track\">\n                                <div id=\"progress-bar-fill\" class=\"progress-bar-fill\"></div>\n                            </div>\n                        </div>\n\n                        <!-- Action Buttons: Success Simulation vs Test Decline -->\n                        <div class=\"checkout-actions-group\">\n                            <button type=\"submit\" id=\"submit-pay-btn\" class=\"btn btn-primary btn-checkout-submit\">\n                                Simulate Successful Payment ($2.99)\n                            </button>\n                            \n                            <button type=\"button\" id=\"decline-pay-btn\" class=\"btn btn-secondary btn-decline-test\" onclick=\"handlePaymentSubmit(event, true)\">\n                                Test Declined Payment State\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Footer Notice with Group Members & Module Details -->\n    <footer class=\"app-footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-top-row\">\n                <div class=\"footer-brand\">\n                    <img src=\"/images/streamwave-logo.png\" alt=\"StreamWave Entertainment Logo\" class=\"footer-logo-img\">\n                </div>\n                <div class=\"footer-module-title\">\n                    <span class=\"module-code-badge\">INFO441</span> CLOUD COMPUTING Group Assignment\n                </div>\n            </div>\n\n            <div class=\"footer-members-grid\">\n                <div class=\"member-chip\"><span class=\"member-name\">Mark Matira</span> <span class=\"member-reg\">R2311376A</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Molivia Fihlabani</span> <span class=\"member-reg\">R242170F</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Munyenyiwa Zivanayi</span> <span class=\"member-reg\">R2215664H</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Yemurai Mhaka</span> <span class=\"member-reg\">R1813118V</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Brian Sonai</span> <span class=\"member-reg\">R2216148H</span></div>\n            </div>\n\n            <p class=\"footer-disclaimer\">\n                <strong>Academic Serverless Prototype</strong> • Built with Python 3.12, FastAPI, and Vercel Serverless Functions.\n                Payment processing and subscription workflows are purely simulated for coursework verification. No actual funds will be debited or transferred.\n            </p>\n        </div>\n    </footer>\n\n    <script>\n        let selectedMethodName = 'ecocash';\n\n        // Pre-fill email from query string if available\n        document.addEventListener('DOMContentLoaded', () => {\n            const params = new URLSearchParams(window.location.search);\n            const emailParam = params.get('email');\n            if (emailParam) {\n                const emailInput = document.getElementById('checkout-email');\n                if (emailInput) emailInput.value = emailParam;\n            }\n        });\n\n        function selectMethod(method) {\n            selectedMethodName = method;\n            document.querySelectorAll('.method-tab').forEach(tab => {\n                const isActive = tab.getAttribute('data-method') === method;\n                tab.classList.toggle('active', isActive);\n                tab.setAttribute('aria-selected', isActive ? 'true' : 'false');\n            });\n\n            document.getElementById('interface-ecocash').style.display = method === 'ecocash' ? 'block' : 'none';\n            document.getElementById('interface-visa').style.display = method === 'visa' ? 'block' : 'none';\n            document.getElementById('interface-mastercard').style.display = method === 'mastercard' ? 'block' : 'none';\n        }\n\n        async function handlePaymentSubmit(e, shouldSimulateDecline = false) {\n            if (e) e.preventDefault();\n\n            const emailInput = document.getElementById('checkout-email');\n            const email = emailInput ? emailInput.value.trim() : '';\n\n            if (!email || !email.includes('@') || !email.includes('.')) {\n                alert('Please enter a valid customer email address.');\n                if (emailInput) emailInput.focus();\n                return;\n            }\n\n            const btn = document.getElementById('submit-pay-btn');\n            const declineBtn = document.getElementById('decline-pay-btn');\n            const statusBox = document.getElementById('simulation-status');\n            const stepText = document.getElementById('simulation-step-text');\n            const progressFill = document.getElementById('progress-bar-fill');\n            const spinner = document.getElementById('status-spinner');\n            const progressTrack = document.getElementById('progress-bar-track');\n\n            // Disable buttons to prevent repeated submissions\n            btn.disabled = true;\n            declineBtn.disabled = true;\n            statusBox.style.display = 'block';\n            statusBox.className = 'simulation-status-box';\n            spinner.style.display = 'block';\n            progressTrack.style.display = 'block';\n\n            const methodTitle = selectedMethodName === 'ecocash' ? 'EcoCash' : (selectedMethodName === 'visa' ? 'Visa' : 'MasterCard');\n\n            // Step Sequence Simulation\n            const steps = shouldSimulateDecline\n                ? [\n                    { msg: `🔒 Validating ${methodTitle} demonstration request...`, pct: '40%' },\n                    { msg: `⚠️ Issuer decline check in progress...`, pct: '80%' }\n                ]\n                : [\n                    { msg: `📱 Requesting ${methodTitle} authorization...`, pct: '30%' },\n                    { msg: `⌛ Authorizing demonstration membership...`, pct: '70%' },\n                    { msg: `✅ ${methodTitle} payment approved!`, pct: '100%' }\n                ];\n\n            // Execute visual step animation\n            for (let i = 0; i < steps.length; i++) {\n                stepText.textContent = steps[i].msg;\n                progressFill.style.width = steps[i].pct;\n                await new Promise(r => setTimeout(r, 550));\n            }\n\n            // Submit ONLY method, plan_id, and optional simulate_decline payload to FastAPI backend\n            try {\n                let res = await fetch('/api/demo-payment', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({\n                        email: email,\n                        method: selectedMethodName,\n                        plan_id: 'streamwave-monthly',\n                        simulate_decline: shouldSimulateDecline\n                    })\n                });\n\n                // Fallback for Vercel serverless function route aliases\n                if (res.status === 404) {\n                    res = await fetch('/demo-payment', {\n                        method: 'POST',\n                        headers: { 'Content-Type': 'application/json' },\n                        body: JSON.stringify({\n                            email: email,\n                            method: selectedMethodName,\n                            plan_id: 'streamwave-monthly',\n                            simulate_decline: shouldSimulateDecline\n                        })\n                    });\n                }\n\n                if (res.ok) {\n                    const data = await res.json();\n                    spinner.style.display = 'none';\n                    statusBox.className = 'simulation-status-box status-success';\n                    stepText.textContent = `✅ Payment Approved! Ref: ${data.tx_ref}. Redirecting to Member Library...`;\n                    \n                    // Brief pause to display transaction reference before redirect\n                    await new Promise(r => setTimeout(r, 1200));\n                    window.location.href = data.redirect_url || '/library';\n                } else {\n                    const err = await res.json();\n                    spinner.style.display = 'none';\n                    progressTrack.style.display = 'none';\n                    statusBox.className = 'simulation-status-box status-declined';\n                    stepText.textContent = `❌ ${err.detail || 'Simulated payment declined.'}`;\n\n                    // Re-enable submission buttons for retry\n                    btn.disabled = false;\n                    declineBtn.disabled = false;\n                }\n            } catch (err) {\n                console.error('Checkout error:', err);\n                spinner.style.display = 'none';\n                progressTrack.style.display = 'none';\n                statusBox.className = 'simulation-status-box status-declined';\n                stepText.textContent = '❌ Network error during simulation. Please try again.';\n                btn.disabled = false;\n                declineBtn.disabled = false;\n            }\n        }\n    </script>\n</body>\n</html>\n","Description":"Add INFO441 Cloud Computing group assignment members and registration numbers to checkout page footer in public/checkout.html","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\public\\checkout.html","toolAction":"Updating public/checkout.html with group member footer","toolSummary":"Updating public/checkout.html with group member footer"}}]}
