            </div>\n\n                <h1 class=\"landing-hero-title\">Zimbabwe’s stories, music and movies — all in one place.</h1>\n                <p class=\"landing-hero-subtitle\">Stream from US$2.99 per month. Cancel anytime.</p>\n                <p class=\"landing-hero-instruction\">Enter your email address to start your StreamWave membership.</p>\n\n                <form class=\"landing-start-form\" id=\"start-form\" onsubmit=\"handleStartMembership(event)\">\n                    <div class=\"input-action-group\">\n                        <label for=\"landing-email-input\" class=\"sr-only\">Email address</label>\n                        <input type=\"email\" id=\"landing-email-input\" placeholder=\"Email address\" required aria-required=\"true\">\n                        <button type=\"submit\" class=\"btn btn-primary btn-get-started\">\n                            Get Started <span class=\"chevron\" aria-hidden=\"true\">›</span>\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </section>\n\n        <!-- Refined Benefits Section: Entertainment That Feels Like Home -->\n        <section class=\"landing-section benefits-section\" aria-label=\"StreamWave Benefits\">\n            <div class=\"section-container\">\n                <h2 class=\"landing-section-title\">Entertainment That Feels Like Home</h2>\n                <p class=\"section-subtitle\">Discover Zimbabwean films, music and creative stories in one beautifully simple streaming experience.</p>\n\n                <div class=\"benefits-grid\">\n                    <!-- Card 1 -->\n                    <article class=\"benefit-card\">\n                        <div class=\"card-icon-container\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e50914\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"benefit-svg-icon\" aria-hidden=\"true\">\n                                <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"2.5\"/>\n                                <line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"22\"/>\n                                <line x1=\"17\" y1=\"2\" x2=\"17\" y2=\"22\"/>\n                                <line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/>\n                                <line x1=\"2\" y1=\"7\" x2=\"7\" y2=\"7\"/>\n                                <line x1=\"2\" y1=\"17\" x2=\"7\" y2=\"17\"/>\n                                <line x1=\"17\" y1=\"17\" x2=\"22\" y2=\"17\"/>\n                                <line x1=\"17\" y1=\"7\" x2=\"22\" y2=\"7\"/>\n                            </svg>\n                        </div>\n                        <h3>Zimbabwean Stories, Centre Stage</h3>\n                        <p>Explore a curated collection of local films and music celebrating Zimbabwe’s established and emerging creative talent.</p>\n                    </article>\n\n                    <!-- Card 2 -->\n                    <article class=\"benefit-card\">\n                        <div class=\"card-icon-container\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e50914\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"benefit-svg-icon\" aria-hidden=\"true\">\n                                <circle cx=\"11\" cy=\"11\" r=\"8\"/>\n                                <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/>\n                                <line x1=\"11\" y1=\"8\" x2=\"11\" y2=\"14\"/>\n                                <line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"/>\n                            </svg>\n                        </div>\n                        <h3>Find Your Next Favourite</h3>\n                        <p>Search by title, artist or genre, preview films and sample tracks before deciding what to enjoy.</p>\n                    </article>\n\n                    <!-- Card 3 -->\n                    <article class=\"benefit-card\">\n                        <div class=\"card-icon-container\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e50914\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"benefit-svg-icon\" aria-hidden=\"true\">\n                                <rect x=\"2\" y=\"3\" width=\"14\" height=\"11\" rx=\"1.5\"/>\n                                <path d=\"M6 18h6\"/>\n                                <path d=\"M9 14v4\"/>\n                                <rect x=\"13\" y=\"8\" width=\"9\" height=\"13\" rx=\"1.5\"/>\n                                <line x1=\"16\" y1=\"18\" x2=\"19\" y2=\"18\"/>\n                            </svg>\n                        </div>\n                        <h3>Enjoy It on Your Screen</h3>\n                        <p>Browse and play content through a responsive experience designed for smartphones, tablets and desktop computers.</p>\n                    </article>\n\n                    <!-- Card 4 -->\n                    <article class=\"benefit-card\">\n                        <div class=\"card-icon-container\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#e50914\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"benefit-svg-icon\" aria-hidden=\"true\">\n                                <rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"/>\n                                <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/>\n                                <line x1=\"6\" y1=\"15\" x2=\"10\" y2=\"15\"/>\n                            </svg>\n                        </div>\n                        <h3>Easy Ways to Access</h3>\n                        <p>Experience a simple subscription demonstration supporting EcoCash, Visa and Mastercard before entering the catalogue.</p>\n                    </article>\n                </div>\n\n                <!-- Call to Action Block -->\n                <div class=\"benefits-cta-block text-center\">\n                    <h3 class=\"cta-title\">Ready to discover something new?</h3>\n                    <p class=\"cta-subtitle\">Explore StreamWave and experience Zimbabwean entertainment in one convenient destination.</p>\n                    <a href=\"/checkout\" class=\"btn btn-primary btn-cta-benefits\" id=\"benefits-cta-btn\">Explore the Catalogue</a>\n                    <p class=\"academic-discreet-note\">Academic prototype: payment and subscription features are simulated, and no real financial transaction is processed.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- How It Works Section -->\n        <section class=\"landing-section how-it-works-section\" aria-label=\"How StreamWave Works\">\n            <div class=\"section-container\">\n                <h2 class=\"landing-section-title\">How It Works</h2>\n                <div class=\"steps-grid\">\n                    <div class=\"step-card\">\n                        <div class=\"step-number\">1</div>\n                        <h3>Create Your Account</h3>\n                        <p>Enter your email address to initiate your StreamWave Monthly membership simulation.</p>\n                    </div>\n                    <div class=\"step-card\">\n                        <div class=\"step-number\">2</div>\n                        <h3>Select Payment Method</h3>\n                        <p>Choose from EcoCash, Visa, or MasterCard simulated academic checkout options.</p>\n                    </div>\n                    <div class=\"step-card\">\n                        <div class=\"step-number\">3</div>\n                        <h3>Start Streaming</h3>\n                        <p>Gain instant access to the member library with signed session authorization.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Supported Payment Methods Section -->\n        <section class=\"landing-section payment-methods-section\" aria-label=\"Supported Payment Methods\">\n            <div class=\"section-container text-center\">\n                <h2 class=\"landing-section-title\">Supported Payment Simulation Methods</h2>\n                <p class=\"section-subtitle\">Convenient demonstration options tailored for Zimbabwe and international users</p>\n\n                <div class=\"payment-badges-row\">\n                    <div class=\"payment-badge ecocash-badge\">\n                        <span class=\"badge-icon\" aria-hidden=\"true\">📱</span> EcoCash\n                    </div>\n                    <div class=\"payment-badge visa-badge\">\n                        <span class=\"badge-icon\" aria-hidden=\"true\">💳</span> Visa\n                    </div>\n                    <div class=\"payment-badge mastercard-badge\">\n                        <span class=\"badge-icon\" aria-hidden=\"true\">💳</span> MasterCard\n                    </div>\n                </div>\n                \n                <div class=\"notice-pill\">\n                    ⚠️ Academic Payment Simulation — No real money will be charged.\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer Notice with Group Members & Module Details -->\n    <footer class=\"app-footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-top-row\">\n                <div class=\"footer-brand\">\n                    <img src=\"/images/streamwave-logo.png\" alt=\"StreamWave Entertainment Logo\" class=\"footer-logo-img\">\n                </div>\n                <div class=\"footer-module-title\">\n                    <span class=\"module-code-badge\">INFO441</span> CLOUD COMPUTING Group Assignment\n                </div>\n            </div>\n\n            <div class=\"footer-members-grid\">\n                <div class=\"member-chip\"><span class=\"member-name\">Mark Matira</span> <span class=\"member-reg\">R2311376A</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Molivia Fihlabani</span> <span class=\"member-reg\">R242170F</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Munyenyiwa Zivanayi</span> <span class=\"member-reg\">R2215664H</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Yemurai Mhaka</span> <span class=\"member-reg\">R1813118V</span></div>\n                <div class=\"member-chip\"><span class=\"member-name\">Brian Sonai</span> <span class=\"member-reg\">R2216148H</span></div>\n            </div>\n\n            <p class=\"footer-disclaimer\">\n                <strong>Academic Serverless Prototype</strong> • Built with Python 3.12, FastAPI, and Vercel Serverless Functions.\n                This is a non-commercial academic demonstration for StreamWave Entertainment. Media titles are presented for Zimbabwean cultural demonstration purposes. Payment processing is simulated for assessment verification. No actual financial data or money is collected or transferred.\n            </p>\n        </div>\n    </footer>\n\n    <script>\n        // Check active session on load\n        async function checkSession() {\n            try {\n                const res = await fetch('/api/session');\n                if (res.ok) {\n                    const data = await res.json();\n                    if (data.authenticated) {\n                        const btn = document.getElementById('nav-signin-btn');\n                        if (btn) {\n                            btn.textContent = 'Go to Library';\n                            btn.href = '/library';\n                        }\n                        const ctaBtn = document.getElementById('benefits-cta-btn');\n                        if (ctaBtn) {\n                            ctaBtn.textContent = 'Go to Member Library';\n                            ctaBtn.href = '/library';\n                        }\n                    }\n                }\n            } catch (e) {\n                console.warn('Session check error:', e);\n            }\n        }\n\n        function handleStartMembership(e) {\n            e.preventDefault();\n            const input = document.getElementById('landing-email-input');\n            const email = input ? input.value.trim() : '';\n            if (email) {\n                window.location.href = `/checkout?email=${encodeURIComponent(email)}`;\n            }\n        }\n\n        document.addEventListener('DOMContentLoaded', checkSession);\n    </script>\n</body>\n</html>\n","Description":"Add INFO441 Cloud Computing group assignment members and registration numbers to landing page footer in public/index.html","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\public\\index.html","toolAction":"Updating public/index.html with group member footer","toolSummary":"Updating public/index.html with group member footer"}}]}
