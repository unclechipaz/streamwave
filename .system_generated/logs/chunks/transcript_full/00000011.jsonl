n    justify-content: center;\n    font-size: 1.1rem;\n    flex-shrink: 0;\n}\n\n.track-text {\n    overflow: hidden;\n}\n\n.track-title {\n    font-size: 0.85rem;\n    font-weight: 600;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.track-artist {\n    font-size: 0.75rem;\n    color: var(--text-muted);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.player-controls {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n}\n\n.player-controls audio {\n    width: 100%;\n    max-width: 480px;\n    height: 36px;\n}\n\n.player-status {\n    display: flex;\n    align-items: center;\n    gap: 0.35rem;\n    font-size: 0.725rem;\n    color: var(--text-muted);\n    min-width: 140px;\n    justify-content: flex-end;\n}\n\n.event-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background-color: var(--text-muted);\n}\n\n.event-dot.active {\n    background-color: var(--accent-red);\n    box-shadow: 0 0 6px var(--accent-red);\n}\n\n/* Responsive Styles for Tablet and Mobile */\n@media (max-width: 900px) {\n    .benefits-grid, .steps-grid, .checkout-grid {\n        grid-template-columns: repeat(1, 1fr);\n    }\n}\n\n@media (max-width: 768px) {\n    .nav-container {\n        flex-wrap: wrap;\n        padding: 0.65rem 1rem;\n    }\n\n    .brand-logo-img {\n        height: 38px;\n    }\n\n    .landing-hero {\n        min-height: auto;\n        padding: 3.5rem 1rem 4rem 1rem;\n    }\n\n    .landing-hero-title {\n        font-size: 2.1rem;\n    }\n\n    .landing-hero-subtitle {\n        font-size: 1.15rem;\n    }\n\n    .input-action-group {\n        flex-direction: column;\n    }\n\n    .btn-get-started {\n        width: 100%;\n    }\n\n    .hero-section {\n        padding: 1.5rem 1.25rem;\n    }\n\n    .hero-title {\n        font-size: 1.75rem;\n    }\n\n    .toolbar {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .search-box {\n        min-width: 100%;\n    }\n\n    .filter-group {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .type-tabs {\n        justify-content: center;\n    }\n\n    .select-wrapper select {\n        width: 100%;\n    }\n\n    .video-dialog {\n        width: 96%;\n    }\n\n    .video-dialog-content {\n        padding: 1rem;\n    }\n\n    .video-modal-title {\n        font-size: 1.2rem;\n    }\n\n    .player-toggle-btn {\n        display: block;\n    }\n\n    .player-container {\n        flex-direction: column;\n        align-items: stretch;\n        gap: 0.4rem;\n    }\n\n    .player-track-info {\n        max-width: 100%;\n    }\n\n    .player-status {\n        justify-content: flex-start;\n    }\n\n    .member-nav-controls {\n        width: 100%;\n        justify-content: space-between;\n        margin-top: 0.5rem;\n    }\n}\n","Description":"Update public/css/styles.css with StreamWave logo watermark styles and clean cinema backdrop","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\public\\css\\styles.css","toolAction":"Updating public/css/styles.css with watermark styling","toolSummary":"Updating public/css/styles.css with watermark styling"}}]}
