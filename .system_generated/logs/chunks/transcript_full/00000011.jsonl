ze: inherit;\n}\n\n/* Accessibility Focus Visible */\n*:focus-visible {\n    outline: 2px solid var(--accent-red) !important;\n    outline-offset: 2px !important;\n}\n\n/* Reduced Motion Respect */\n@media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.01ms !important;\n        scroll-behavior: auto !important;\n    }\n}\n\n/* Navigation Bar */\n.navbar {\n    background-color: var(--bg-surface);\n    border-bottom: 1px solid var(--border-color);\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    height: 70px;\n    display: flex;\n    align-items: center;\n}\n\n.nav-container {\n    max-width: 1240px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 0 1.5rem;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 1rem;\n}\n\n.brand {\n    display: flex;\n    align-items: center;\n    gap: 0.4rem;\n    font-weight: 800;\n    font-size: 1.2rem;\n    letter-spacing: -0.02em;\n    color: var(--text-primary);\n}\n\n.brand-logo-img {\n    height: 48px;\n    max-height: 52px;\n    width: auto;\n    object-fit: contain;\n    display: block;\n    transition: transform 0.15s ease;\n}\n\n.brand-logo-img:hover {\n    transform: scale(1.02);\n}\n\n.footer-logo-img {\n    height: 36px;\n    width: auto;\n    object-fit: contain;\n    display: block;\n}\n\n.nav-links {\n    display: flex;\n    gap: 1rem;\n    align-items: center;\n}\n\n.nav-link {\n    color: var(--text-secondary);\n    font-size: 0.875rem;\n    font-weight: 500;\n    transition: color 0.15s ease;\n}\n\n.nav-link:hover, .nav-link.active {\n    color: var(--text-primary);\n}\n\n.developer-link {\n    color: var(--accent-red);\n    font-weight: 600;\n    font-size: 0.8rem;\n    background-color: var(--accent-red-subtle);\n    padding: 0.2rem 0.55rem;\n    border-radius: var(--radius-sm);\n    border: 1px solid rgba(229, 9, 20, 0.3);\n    display: inline-flex;\n    align-items: center;\n    gap: 0.25rem;\n}\n\n.btn-signin-nav {\n    font-size: 0.85rem;\n    padding: 0.35rem 0.95rem;\n}\n\n.member-nav-controls {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n}\n\n.member-badge {\n    display: flex;\n    align-items: center;\n    gap: 0.35rem;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    padding: 0.25rem 0.65rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.775rem;\n    font-weight: 600;\n    color: var(--text-primary);\n}\n\n.btn-sm {\n    padding: 0.3rem 0.75rem;\n    font-size: 0.8rem;\n}\n\n.pulse-dot {\n    width: 7px;\n    height: 7px;\n    background-color: #10b981;\n    border-radius: 50%;\n    box-shadow: 0 0 8px #10b981;\n}\n\n/* Full-Height Viewport Centered Hero Section */\n.landing-main {\n    flex: 1;\n}\n\n.landing-hero {\n    position: relative;\n    min-height: calc(100vh - 70px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 3rem 1.5rem;\n    background-color: #0b0b0d;\n    background-image: radial-gradient(circle at center, rgba(229, 9, 20, 0.28) 0%, rgba(18, 18, 20, 0.97) 75%), url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1600&q=80');\n    background-size: cover;\n    background-position: center;\n    border-bottom: 1px solid var(--border-color);\n    text-align: center;\n    overflow: hidden;\n}\n\n.hero-bg-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to bottom, rgba(18, 18, 20, 0.92) 0%, rgba(18, 18, 20, 0.82) 50%, rgba(18, 18, 20, 0.98) 100%);\n    pointer-events: none;\n    z-index: 1;\n}\n\n/* StreamWave Brand Logo Watermark in Hero Backdrop */\n.hero-watermark {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    opacity: 0.08; /* Subtle StreamWave watermark */\n    pointer-events: none;\n    z-index: 1;\n    width: 60%;\n    max-width: 680px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.watermark-logo-img {\n    width: 100%;\n    height: auto;\n    object-fit: contain;\n    filter: drop-shadow(0 0 40px var(--accent-red));\n}\n\n.landing-hero-content {\n    position: relative;\n    z-index: 2;\n    max-width: 820px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 1.25rem;\n}\n\n.academic-badge-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    background-color: rgba(24, 24, 28, 0.92);\n    border: 1px solid var(--border-color);\n    padding: 0.25rem 0.8rem;\n    border-radius: 50px;\n    font-size: 0.725rem;\n    font-weight: 600;\n    color: var(--text-secondary);\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n}\n\n.landing-hero-title {\n    font-size: 3.15rem;\n    font-weight: 900;\n    line-height: 1.12;\n    letter-spacing: -0.035em;\n    color: #ffffff;\n}\n\n.landing-hero-subtitle {\n    font-size: 1.4rem;\n    font-weight: 500;\n    color: var(--text-primary);\n}\n\n.landing-hero-instruction {\n    font-size: 1.05rem;\n    color: var(--text-secondary);\n    margin-top: 0.2rem;\n}\n\n.landing-start-form {\n    width: 100%;\n    max-width: 620px;\n    margin-top: 0.5rem;\n}\n\n.input-action-group {\n    display: flex;\n    gap: 0.5rem;\n    width: 100%;\n}\n\n.input-action-group input {\n    flex: 1;\n    background-color: rgba(22, 22, 26, 0.92);\n    border: 1px solid rgba(255, 255, 255, 0.35);\n    color: #ffffff;\n    padding: 0.95rem 1.25rem;\n    border-radius: var(--radius-sm);\n    font-size: 1rem;\n    outline: none;\n    transition: border-color 0.15s ease;\n}\n\n.input-action-group input:focus {\n    border-color: var(--accent-red);\n}\n\n.btn-get-started {\n    font-size: 1.2rem;\n    font-weight: 700;\n    padding: 0.95rem 1.75rem;\n    white-space: nowrap;\n    border-radius: var(--radius-sm);\n}\n\n.btn-get-started .chevron {\n    font-size: 1.4rem;\n    font-weight: 400;\n    margin-left: 0.25rem;\n}\n\n/* Landing Page Sections */\n.landing-section {\n    padding: 4.5rem 1.5rem;\n    border-bottom: 1px solid var(--border-color);\n}\n\n.section-container {\n    max-width: 1140px;\n    margin: 0 auto;\n}\n\n.landing-section-title {\n    font-size: 2rem;\n    font-weight: 800;\n    text-align: center;\n    margin-bottom: 2.5rem;\n    letter-spacing: -0.02em;\n}\n\n.section-subtitle {\n    text-align: center;\n    color: var(--text-secondary);\n    font-size: 1rem;\n    margin-top: -1.75rem;\n    margin-bottom: 2.25rem;\n}\n\n/* Benefits Grid */\n.benefits-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1.5rem;\n}\n\n.benefit-card {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    padding: 1.75rem 1.25rem;\n    border-radius: var(--radius-md);\n    text-align: center;\n}\n\n.benefit-icon {\n    font-size: 2.25rem;\n    margin-bottom: 0.85rem;\n}\n\n.benefit-card h3 {\n    font-size: 1.1rem;\n    font-weight: 700;\n    margin-bottom: 0.5rem;\n}\n\n.benefit-card p {\n    font-size: 0.875rem;\n    color: var(--text-secondary);\n    line-height: 1.5;\n}\n\n/* Steps Grid (How It Works) */\n.steps-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.75rem;\n}\n\n.step-card {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    padding: 2rem 1.5rem;\n    border-radius: var(--radius-md);\n    position: relative;\n}\n\n.step-number {\n    width: 42px;\n    height: 42px;\n    background-color: var(--accent-red);\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 1.25rem;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 1rem;\n}\n\n.step-card h3 {\n    font-size: 1.15rem;\n    font-weight: 700;\n    margin-bottom: 0.4rem;\n}\n\n.step-card p {\n    font-size: 0.875rem;\n    color: var(--text-secondary);\n    line-height: 1.5;\n}\n\n/* Payment Badges */\n.payment-badges-row {\n    display: flex;\n    justify-content: center;\n    gap: 1.5rem;\n    margin-bottom: 1.75rem;\n    flex-wrap: wrap;\n}\n\n.payment-badge {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    padding: 0.75rem 1.75rem;\n    border-radius: var(--radius-md);\n    font-weight: 700;\n    font-size: 1.1rem;\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n}\n\n.notice-pill {\n    display: inline-block;\n    background-color: var(--accent-red-subtle);\n    border: 1px solid rgba(229, 9, 20, 0.4);\n    color: var(--text-primary);\n    padding: 0.5rem 1.25rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.85rem;\n    font-weight: 600;\n}\n\n/* Checkout Page Styling */\n.checkout-main {\n    max-width: 1040px;\n    width: 100%;\n    margin: 2rem auto;\n    padding: 0 1.5rem;\n    flex: 1;\n}\n\n.simulation-alert-banner {\n    background-color: #2b1d05;\n    border: 1px solid #d97706;\n    color: #fef3c7;\n    padding: 1rem 1.25rem;\n    border-radius: var(--radius-md);\n    display: flex;\n    align-items: center;\n    gap: 0.85rem;\n    margin-bottom: 1.75rem;\n}\n\n.alert-icon {\n    font-size: 1.5rem;\n}\n\n.alert-text strong {\n    font-size: 0.95rem;\n    letter-spacing: 0.04em;\n}\n\n.alert-text p {\n    font-size: 0.85rem;\n    margin-top: 0.15rem;\n    opacity: 0.9;\n}\n\n.checkout-grid {\n    display: grid;\n    grid-template-columns: 1fr 1.35fr;\n    gap: 1.75rem;\n}\n\n.summary-box, .payment-form-box {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    padding: 1.75rem;\n}\n\n.box-title {\n    font-size: 1.25rem;\n    font-weight: 800;\n    margin-bottom: 1.25rem;\n    letter-spacing: -0.015em;\n}\n\n.plan-card {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    padding: 1.25rem;\n    border-radius: var(--radius-sm);\n}\n\n.plan-badge {\n    color: var(--accent-red);\n    font-size: 0.7rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n}\n\n.plan-name {\n    font-size: 1.35rem;\n    font-weight: 800;\n    margin-top: 0.15rem;\n}\n\n.plan-price {\n    font-size: 1.75rem;\n    font-weight: 900;\n    color: var(--text-primary);\n    margin: 0.65rem 0 1rem 0;\n}\n\n.price-period {\n    font-size: 0.9rem;\n    font-weight: 500;\n    color: var(--text-muted);\n}\n\n.plan-benefits-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n    font-size: 0.85rem;\n    color: var(--text-secondary);\n}\n\n.check-icon {\n    color: #10b981;\n    font-weight: 800;\n    margin-right: 0.35rem;\n}\n\n.form-group {\n    margin-bottom: 1.25rem;\n}\n\n.form-label {\n    display: block;\n    font-size: 0.825rem;\n    font-weight: 600;\n    color: var(--text-secondary);\n    margin-bottom: 0.35rem;\n}\n\n.form-input {\n    width: 100%;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-primary);\n    padding: 0.75rem 1rem;\n    border-radius: var(--radius-sm);\n    outline: none;\n    transition: border-color 0.15s ease;\n}\n\n.form-input:focus {\n    border-color: var(--accent-red);\n}\n\n/* Method Tabs */\n.method-tabs {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0.5rem;\n    margin-bottom: 1.25rem;\n}\n\n.method-tab {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-secondary);\n    padding: 0.65rem 0.5rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.85rem;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.15s ease;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.35rem;\n}\n\n.method-tab.active {\n    background-color: var(--accent-red-subtle);\n    border-color: var(--accent-red);\n    color: #ffffff;\n}\n\n.interface-box {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    padding: 1.25rem;\n    border-radius: var(--radius-sm);\n    margin-bottom: 1.25rem;\n}\n\n.demo-tag {\n    display: inline-block;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.675rem;\n    font-weight: 700;\n    padding: 0.15rem 0.45rem;\n    border-radius: var(--radius-sm);\n    text-transform: uppercase;\n    margin-bottom: 0.75rem;\n}\n\n.step-sequence-list {\n    margin-top: 0.85rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0.4rem;\n}\n\n.step-item {\n    font-size: 0.8rem;\n    color: var(--text-secondary);\n    display: flex;\n    align-items: center;\n    gap: 0.4rem;\n}\n\n.step-bullet {\n    width: 18px;\n    height: 18px;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: 50%;\n    font-size: 0.65rem;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--accent-red);\n}\n\n.help-text {\n    font-size: 0.775rem;\n    color: var(--text-muted);\n    margin-top: 0.5rem;\n}\n\n.test-card-preview {\n    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    padding: 1.25rem;\n    color: #ffffff;\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.mastercard-theme {\n    background: linear-gradient(135deg, #374151 0%, #1f2937 100%);\n}\n\n.card-chip {\n    width: 34px;\n    height: 24px;\n    background-color: #d97706;\n    border-radius: 4px;\n}\n\n.card-number-display {\n    font-family: monospace;\n    font-size: 1.15rem;\n    letter-spacing: 0.15em;\n}\n\n.card-details-row {\n    display: flex;\n    justify-content: space-between;\n    font-size: 0.75rem;\n    color: var(--text-secondary);\n}\n\n.simulation-status-box {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--accent-red);\n    padding: 1rem;\n    border-radius: var(--radius-sm);\n    margin-bottom: 1.25rem;\n    text-align: center;\n}\n\n.status-success {\n    border-color: #10b981;\n    background-color: rgba(16, 185, 129, 0.1);\n}\n\n.status-declined {\n    border-color: #ef4444;\n    background-color: rgba(239, 68, 68, 0.1);\n}\n\n.status-spinner {\n    width: 24px;\n    height: 24px;\n    border: 2px solid var(--border-color);\n    border-top-color: var(--accent-red);\n    border-radius: 50%;\n    animation: spin 0.8s linear infinite;\n    margin: 0 auto 0.5rem auto;\n}\n\n.simulation-step-text {\n    font-size: 0.85rem;\n    font-weight: 600;\n    color: var(--text-primary);\n    margin-bottom: 0.5rem;\n}\n\n.progress-bar-track {\n    width: 100%;\n    height: 6px;\n    background-color: var(--bg-surface);\n    border-radius: 3px;\n    overflow: hidden;\n}\n\n.progress-bar-fill {\n    height: 100%;\n    width: 0%;\n    background-color: var(--accent-red);\n    transition: width 0.4s ease;\n}\n\n.checkout-actions-group {\n    display: flex;\n    flex-direction: column;\n    gap: 0.65rem;\n}\n\n.btn-checkout-submit {\n    width: 100%;\n    padding: 0.85rem;\n    font-size: 1rem;\n}\n\n.btn-decline-test {\n    width: 100%;\n    padding: 0.6rem;\n    font-size: 0.825rem;\n    color: var(--text-muted);\n    border: 1px dashed var(--border-color);\n}\n\n.btn-decline-test:hover {\n    color: #ef4444;\n    border-color: #ef4444;\n}\n\n/* Main Container for Library */\n.main-content {\n    max-width: 1240px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 1.5rem;\n    flex: 1;\n}\n\n/* Hero / Featured Section */\n.hero-section {\n    position: relative;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    padding: 2.25rem 2rem;\n    margin-bottom: 2rem;\n    overflow: hidden;\n    background-image: linear-gradient(to right, rgba(24, 24, 28, 0.95) 45%, rgba(24, 24, 28, 0.65)), url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1200&q=80');\n    background-size: cover;\n    background-position: center;\n}\n\n.hero-content {\n    position: relative;\n    z-index: 2;\n    max-width: 620px;\n}\n\n.hero-tag-group {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    margin-bottom: 0.4rem;\n}\n\n.hero-tag {\n    color: var(--accent-red);\n    font-size: 0.725rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n}\n\n.tech-sample-pill {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.675rem;\n    font-weight: 600;\n    padding: 0.1rem 0.4rem;\n    border-radius: var(--radius-sm);\n}\n\n.hero-title {\n    font-size: 2.25rem;\n    font-weight: 800;\n    line-height: 1.15;\n    margin-bottom: 0.4rem;\n    letter-spacing: -0.025em;\n}\n\n.hero-meta {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    color: var(--text-secondary);\n    font-size: 0.85rem;\n    margin-bottom: 0.85rem;\n    flex-wrap: wrap;\n}\n\n.meta-tag {\n    background-color: var(--accent-red-subtle);\n    color: var(--accent-red);\n    padding: 0.1rem 0.4rem;\n    border-radius: var(--radius-sm);\n    font-weight: 600;\n    text-transform: uppercase;\n    font-size: 0.725rem;\n}\n\n.meta-separator {\n    color: var(--text-muted);\n}\n\n.hero-description {\n    color: var(--text-secondary);\n    font-size: 0.925rem;\n    margin-bottom: 1.25rem;\n    line-height: 1.55;\n}\n\n.hero-actions {\n    display: flex;\n    gap: 0.75rem;\n}\n\n/* Buttons */\n.btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.4rem;\n    padding: 0.55rem 1.1rem;\n    border-radius: var(--radius-sm);\n    font-weight: 600;\n    font-size: 0.875rem;\n    cursor: pointer;\n    border: 1px solid transparent;\n    transition: background-color 0.15s ease, border-color 0.15s ease;\n}\n\n.btn-primary {\n    background-color: var(--accent-red);\n    color: #ffffff;\n}\n\n.btn-primary:hover {\n    background-color: var(--accent-red-hover);\n}\n\n.btn-secondary {\n    background-color: var(--bg-elevated);\n    color: var(--text-primary);\n    border-color: var(--border-color);\n}\n\n.btn-secondary:hover {\n    background-color: var(--bg-hover);\n}\n\n/* Catalogue Section */\n.section-header {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    margin-bottom: 1rem;\n}\n\n.section-title {\n    font-size: 1.25rem;\n    font-weight: 700;\n    letter-spacing: -0.015em;\n}\n\n.item-count {\n    color: var(--text-muted);\n    font-size: 0.825rem;\n}\n\n.toolbar {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin-bottom: 1.5rem;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    padding: 0.75rem 1rem;\n    border-radius: var(--radius-md);\n    align-items: center;\n    justify-content: space-between;\n}\n\n.search-box {\n    position: relative;\n    flex: 1;\n    min-width: 250px;\n    display: flex;\n    align-items: center;\n}\n\n.search-icon {\n    position: absolute;\n    left: 0.75rem;\n    font-size: 0.85rem;\n    color: var(--text-muted);\n    pointer-events: none;\n}\n\n.search-box input {\n    width: 100%;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-primary);\n    padding: 0.5rem 2.2rem 0.5rem 2.2rem;\n    border-radius: var(--radius-sm);\n    outline: none;\n    transition: border-color 0.15s ease;\n}\n\n.search-box input:focus {\n    border-color: var(--border-focus);\n}\n\n.clear-btn {\n    position: absolute;\n    right: 0.6rem;\n    background: none;\n    border: none;\n    color: var(--text-muted);\n    font-size: 0.95rem;\n    cursor: pointer;\n}\n\n.clear-btn:hover {\n    color: var(--text-primary);\n}\n\n.filter-group {\n    display: flex;\n    gap: 0.75rem;\n    align-items: center;\n    flex-wrap: wrap;\n}\n\n.type-tabs {\n    display: flex;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-sm);\n    padding: 2px;\n}\n\n.type-tab {\n    background: none;\n    border: none;\n    color: var(--text-secondary);\n    padding: 0.35rem 0.85rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.825rem;\n    font-weight: 500;\n    cursor: pointer;\n    transition: color 0.15s ease, background-color 0.15s ease;\n}\n\n.type-tab.active {\n    background-color: var(--bg-hover);\n    color: var(--text-primary);\n    font-weight: 600;\n}\n\n.select-wrapper select {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-primary);\n    padding: 0.4rem 0.85rem;\n    border-radius: var(--radius-sm);\n    outline: none;\n    cursor: pointer;\n    font-size: 0.825rem;\n}\n\n.select-wrapper select:focus {\n    border-color: var(--border-focus);\n}\n\n/* UI States */\n.state-view {\n    text-align: center;\n    padding: 3rem 1rem;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n}\n\n.state-icon {\n    font-size: 2rem;\n    margin-bottom: 0.5rem;\n}\n\n.state-view h3 {\n    font-size: 1.05rem;\n    margin-bottom: 0.3rem;\n}\n\n.state-view p {\n    color: var(--text-secondary);\n    font-size: 0.875rem;\n    margin-bottom: 1rem;\n}\n\n.spinner {\n    width: 32px;\n    height: 32px;\n    border: 3px solid var(--border-color);\n    border-top-color: var(--accent-red);\n    border-radius: 50%;\n    animation: spin 0.8s linear infinite;\n    margin: 0 auto 1rem auto;\n}\n\n@keyframes spin {\n    to { transform: rotate(360deg); }\n}\n\n/* Media Cards Grid */\n.media-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1.25rem;\n}\n\n@media (max-width: 1199px) {\n    .media-grid {\n        grid-template-columns: repeat(3, 1fr);\n    }\n}\n\n@media (max-width: 899px) {\n    .media-grid {\n        grid-template-columns: repeat(2, 1fr);\n    }\n}\n\n@media (max-width: 599px) {\n    .media-grid {\n        grid-template-columns: repeat(1, 1fr);\n    }\n}\n\n/* Media Card Styling */\n.media-card {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    transition: transform 0.15s ease, border-color 0.15s ease;\n}\n\n.media-card:hover {\n    transform: translateY(-2px);\n    border-color: var(--text-muted);\n}\n\n.card-thumb-wrapper {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 16/9;\n    background-color: var(--bg-elevated);\n    overflow: hidden;\n    cursor: pointer;\n}\n\n.card-thumb {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.25s ease;\n}\n\n.card-thumb-wrapper:hover .card-thumb {\n    transform: scale(1.04);\n}\n\n.card-badge {\n    position: absolute;\n    top: 0.5rem;\n    left: 0.5rem;\n    background-color: rgba(18, 18, 20, 0.9);\n    border: 1px solid var(--border-color);\n    color: var(--accent-red);\n    font-size: 0.675rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    padding: 0.125rem 0.45rem;\n    border-radius: var(--radius-sm);\n    letter-spacing: 0.04em;\n}\n\n.tech-sample-tag {\n    position: absolute;\n    bottom: 0.5rem;\n    right: 0.5rem;\n    background-color: rgba(18, 18, 20, 0.85);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.625rem;\n    padding: 0.1rem 0.35rem;\n    border-radius: var(--radius-sm);\n}\n\n.card-content {\n    padding: 0.95rem;\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n}\n\n.card-title {\n    font-size: 0.975rem;\n    font-weight: 700;\n    line-height: 1.35;\n    margin-bottom: 0.25rem;\n    color: var(--text-primary);\n    cursor: pointer;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    max-height: 2.7em;\n}\n\n.card-title:hover {\n    color: var(--accent-red);\n}\n\n.card-subtitle {\n    color: var(--text-secondary);\n    font-size: 0.825rem;\n    margin-bottom: 0.4rem;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.card-meta {\n    display: flex;\n    gap: 0.4rem;\n    align-items: center;\n    color: var(--text-muted);\n    font-size: 0.775rem;\n    margin-bottom: 0.85rem;\n}\n\n.card-actions {\n    margin-top: auto;\n    display: flex;\n    gap: 0.4rem;\n}\n\n.card-actions .btn {\n    flex: 1;\n    padding: 0.4rem 0.5rem;\n    font-size: 0.8rem;\n}\n\n/* Application Footer */\n.app-footer {\n    background-color: var(--bg-surface);\n    border-top: 1px solid var(--border-color);\n    padding: 1.5rem;\n    margin-top: auto;\n}\n\n.footer-container {\n    max-width: 1240px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n}\n\n.footer-brand {\n    font-weight: 700;\n    font-size: 0.9rem;\n    color: var(--text-primary);\n}\n\n.footer-disclaimer {\n    color: var(--text-muted);\n    font-size: 0.775rem;\n    line-height: 1.5;\n}\n\n/* Details Dialog Modal */\n.details-dialog {\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    background-color: var(--bg-surface);\n    color: var(--text-primary);\n    max-width: 580px;\n    width: 90%;\n    margin: auto;\n    padding: 0;\n    box-shadow: var(--shadow-dialog);\n}\n\n.details-dialog::backdrop {\n    background-color: rgba(0, 0, 0, 0.8);\n    backdrop-filter: blur(2px);\n}\n\n.dialog-content {\n    position: relative;\n    padding: 1.75rem;\n}\n\n.dialog-close {\n    position: absolute;\n    top: 1rem;\n    right: 1rem;\n    background: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-secondary);\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 10;\n}\n\n.dialog-close:hover {\n    color: var(--text-primary);\n    border-color: var(--text-muted);\n}\n\n.dialog-header-meta {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    margin-bottom: 0.4rem;\n}\n\n.dialog-title {\n    font-size: 1.5rem;\n    font-weight: 800;\n    line-height: 1.25;\n    margin-bottom: 0.2rem;\n}\n\n.dialog-artist {\n    color: var(--text-secondary);\n    font-size: 0.9rem;\n    margin-bottom: 0.85rem;\n}\n\n.dialog-description {\n    color: var(--text-secondary);\n    font-size: 0.875rem;\n    line-height: 1.6;\n    margin-bottom: 1.1rem;\n    background-color: var(--bg-elevated);\n    padding: 0.85rem 1rem;\n    border-radius: var(--radius-sm);\n    border-left: 3px solid var(--accent-red);\n}\n\n.dialog-info-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0.75rem;\n    margin-bottom: 1.25rem;\n}\n\n.info-item {\n    background-color: var(--bg-elevated);\n    padding: 0.45rem 0.65rem;\n    border-radius: var(--radius-sm);\n    border: 1px solid var(--border-color);\n}\n\n.info-label {\n    font-size: 0.675rem;\n    color: var(--text-muted);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n}\n\n.info-value {\n    font-size: 0.825rem;\n    font-weight: 600;\n}\n\n/* Video Player Modal Styling */\n.video-dialog {\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    background-color: #121214;\n    color: var(--text-primary);\n    max-width: 960px;\n    width: 92%;\n    margin: auto;\n    padding: 0;\n    box-shadow: var(--shadow-dialog);\n    overflow: hidden;\n}\n\n.video-dialog::backdrop {\n    background-color: rgba(0, 0, 0, 0.85);\n    backdrop-filter: blur(4px);\n}\n\n.video-dialog-content {\n    position: relative;\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: 