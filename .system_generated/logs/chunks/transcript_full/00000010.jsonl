rder-radius: 3px;\n    overflow: hidden;\n}\n\n.progress-bar-fill {\n    height: 100%;\n    width: 0%;\n    background-color: var(--accent-red);\n    transition: width 0.4s ease;\n}\n\n.checkout-actions-group {\n    display: flex;\n    flex-direction: column;\n    gap: 0.65rem;\n}\n\n.btn-checkout-submit {\n    width: 100%;\n    padding: 0.85rem;\n    font-size: 1rem;\n}\n\n.btn-decline-test {\n    width: 100%;\n    padding: 0.6rem;\n    font-size: 0.825rem;\n    color: var(--text-muted);\n    border: 1px dashed var(--border-color);\n}\n\n.btn-decline-test:hover {\n    color: #ef4444;\n    border-color: #ef4444;\n}\n\n/* Main Container for Library */\n.main-content {\n    max-width: 1240px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 1.5rem;\n    flex: 1;\n}\n\n/* Hero / Featured Section */\n.hero-section {\n    position: relative;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    padding: 2.25rem 2rem;\n    margin-bottom: 2rem;\n    overflow: hidden;\n    background-image: linear-gradient(to right, rgba(24, 24, 28, 0.95) 45%, rgba(24, 24, 28, 0.65)), url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1200&q=80');\n    background-size: cover;\n    background-position: center;\n}\n\n.hero-content {\n    position: relative;\n    z-index: 2;\n    max-width: 620px;\n}\n\n.hero-tag-group {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    margin-bottom: 0.4rem;\n}\n\n.hero-tag {\n    color: var(--accent-red);\n    font-size: 0.725rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n}\n\n.tech-sample-pill {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.675rem;\n    font-weight: 600;\n    padding: 0.1rem 0.4rem;\n    border-radius: var(--radius-sm);\n}\n\n.hero-title {\n    font-size: 2.25rem;\n    font-weight: 800;\n    line-height: 1.15;\n    margin-bottom: 0.4rem;\n    letter-spacing: -0.025em;\n}\n\n.hero-meta {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    color: var(--text-secondary);\n    font-size: 0.85rem;\n    margin-bottom: 0.85rem;\n    flex-wrap: wrap;\n}\n\n.meta-tag {\n    background-color: var(--accent-red-subtle);\n    color: var(--accent-red);\n    padding: 0.1rem 0.4rem;\n    border-radius: var(--radius-sm);\n    font-weight: 600;\n    text-transform: uppercase;\n    font-size: 0.725rem;\n}\n\n.meta-separator {\n    color: var(--text-muted);\n}\n\n.hero-description {\n    color: var(--text-secondary);\n    font-size: 0.925rem;\n    margin-bottom: 1.25rem;\n    line-height: 1.55;\n}\n\n.hero-actions {\n    display: flex;\n    gap: 0.75rem;\n}\n\n/* Buttons */\n.btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.4rem;\n    padding: 0.55rem 1.1rem;\n    border-radius: var(--radius-sm);\n    font-weight: 600;\n    font-size: 0.875rem;\n    cursor: pointer;\n    border: 1px solid transparent;\n    transition: background-color 0.15s ease, border-color 0.15s ease;\n}\n\n.btn-primary {\n    background-color: var(--accent-red);\n    color: #ffffff;\n}\n\n.btn-primary:hover {\n    background-color: var(--accent-red-hover);\n}\n\n.btn-secondary {\n    background-color: var(--bg-elevated);\n    color: var(--text-primary);\n    border-color: var(--border-color);\n}\n\n.btn-secondary:hover {\n    background-color: var(--bg-hover);\n}\n\n/* Catalogue Section */\n.section-header {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    margin-bottom: 1rem;\n}\n\n.section-title {\n    font-size: 1.25rem;\n    font-weight: 700;\n    letter-spacing: -0.015em;\n}\n\n.item-count {\n    color: var(--text-muted);\n    font-size: 0.825rem;\n}\n\n.toolbar {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n    margin-bottom: 1.5rem;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    padding: 0.75rem 1rem;\n    border-radius: var(--radius-md);\n    align-items: center;\n    justify-content: space-between;\n}\n\n.search-box {\n    position: relative;\n    flex: 1;\n    min-width: 250px;\n    display: flex;\n    align-items: center;\n}\n\n.search-icon {\n    position: absolute;\n    left: 0.75rem;\n    font-size: 0.85rem;\n    color: var(--text-muted);\n    pointer-events: none;\n}\n\n.search-box input {\n    width: 100%;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-primary);\n    padding: 0.5rem 2.2rem 0.5rem 2.2rem;\n    border-radius: var(--radius-sm);\n    outline: none;\n    transition: border-color 0.15s ease;\n}\n\n.search-box input:focus {\n    border-color: var(--border-focus);\n}\n\n.clear-btn {\n    position: absolute;\n    right: 0.6rem;\n    background: none;\n    border: none;\n    color: var(--text-muted);\n    font-size: 0.95rem;\n    cursor: pointer;\n}\n\n.clear-btn:hover {\n    color: var(--text-primary);\n}\n\n.filter-group {\n    display: flex;\n    gap: 0.75rem;\n    align-items: center;\n    flex-wrap: wrap;\n}\n\n.type-tabs {\n    display: flex;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-sm);\n    padding: 2px;\n}\n\n.type-tab {\n    background: none;\n    border: none;\n    color: var(--text-secondary);\n    padding: 0.35rem 0.85rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.825rem;\n    font-weight: 500;\n    cursor: pointer;\n    transition: color 0.15s ease, background-color 0.15s ease;\n}\n\n.type-tab.active {\n    background-color: var(--bg-hover);\n    color: var(--text-primary);\n    font-weight: 600;\n}\n\n.select-wrapper select {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-primary);\n    padding: 0.4rem 0.85rem;\n    border-radius: var(--radius-sm);\n    outline: none;\n    cursor: pointer;\n    font-size: 0.825rem;\n}\n\n.select-wrapper select:focus {\n    border-color: var(--border-focus);\n}\n\n/* UI States */\n.state-view {\n    text-align: center;\n    padding: 3rem 1rem;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n}\n\n.state-icon {\n    font-size: 2rem;\n    margin-bottom: 0.5rem;\n}\n\n.state-view h3 {\n    font-size: 1.05rem;\n    margin-bottom: 0.3rem;\n}\n\n.state-view p {\n    color: var(--text-secondary);\n    font-size: 0.875rem;\n    margin-bottom: 1rem;\n}\n\n.spinner {\n    width: 32px;\n    height: 32px;\n    border: 3px solid var(--border-color);\n    border-top-color: var(--accent-red);\n    border-radius: 50%;\n    animation: spin 0.8s linear infinite;\n    margin: 0 auto 1rem auto;\n}\n\n@keyframes spin {\n    to { transform: rotate(360deg); }\n}\n\n/* Media Cards Grid */\n.media-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1.25rem;\n}\n\n@media (max-width: 1199px) {\n    .media-grid {\n        grid-template-columns: repeat(3, 1fr);\n    }\n}\n\n@media (max-width: 899px) {\n    .media-grid {\n        grid-template-columns: repeat(2, 1fr);\n    }\n}\n\n@media (max-width: 599px) {\n    .media-grid {\n        grid-template-columns: repeat(1, 1fr);\n    }\n}\n\n/* Media Card Styling */\n.media-card {\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    transition: transform 0.15s ease, border-color 0.15s ease;\n}\n\n.media-card:hover {\n    transform: translateY(-2px);\n    border-color: var(--text-muted);\n}\n\n.card-thumb-wrapper {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 16/9;\n    background-color: var(--bg-elevated);\n    overflow: hidden;\n    cursor: pointer;\n}\n\n.card-thumb {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.25s ease;\n}\n\n.card-thumb-wrapper:hover .card-thumb {\n    transform: scale(1.04);\n}\n\n.card-badge {\n    position: absolute;\n    top: 0.5rem;\n    left: 0.5rem;\n    background-color: rgba(18, 18, 20, 0.9);\n    border: 1px solid var(--border-color);\n    color: var(--accent-red);\n    font-size: 0.675rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    padding: 0.125rem 0.45rem;\n    border-radius: var(--radius-sm);\n    letter-spacing: 0.04em;\n}\n\n.tech-sample-tag {\n    position: absolute;\n    bottom: 0.5rem;\n    right: 0.5rem;\n    background-color: rgba(18, 18, 20, 0.85);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.625rem;\n    padding: 0.1rem 0.35rem;\n    border-radius: var(--radius-sm);\n}\n\n.card-content {\n    padding: 0.95rem;\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n}\n\n.card-title {\n    font-size: 0.975rem;\n    font-weight: 700;\n    line-height: 1.35;\n    margin-bottom: 0.25rem;\n    color: var(--text-primary);\n    cursor: pointer;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    max-height: 2.7em;\n}\n\n.card-title:hover {\n    color: var(--accent-red);\n}\n\n.card-subtitle {\n    color: var(--text-secondary);\n    font-size: 0.825rem;\n    margin-bottom: 0.4rem;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.card-meta {\n    display: flex;\n    gap: 0.4rem;\n    align-items: center;\n    color: var(--text-muted);\n    font-size: 0.775rem;\n    margin-bottom: 0.85rem;\n}\n\n.card-actions {\n    margin-top: auto;\n    display: flex;\n    gap: 0.4rem;\n}\n\n.card-actions .btn {\n    flex: 1;\n    padding: 0.4rem 0.5rem;\n    font-size: 0.8rem;\n}\n\n/* Application Footer */\n.app-footer {\n    background-color: var(--bg-surface);\n    border-top: 1px solid var(--border-color);\n    padding: 1.5rem;\n    margin-top: auto;\n}\n\n.footer-container {\n    max-width: 1240px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n}\n\n.footer-brand {\n    font-weight: 700;\n    font-size: 0.9rem;\n    color: var(--text-primary);\n}\n\n.footer-disclaimer {\n    color: var(--text-muted);\n    font-size: 0.775rem;\n    line-height: 1.5;\n}\n\n/* Details Dialog Modal */\n.details-dialog {\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    background-color: var(--bg-surface);\n    color: var(--text-primary);\n    max-width: 580px;\n    width: 90%;\n    margin: auto;\n    padding: 0;\n    box-shadow: var(--shadow-dialog);\n}\n\n.details-dialog::backdrop {\n    background-color: rgba(0, 0, 0, 0.8);\n    backdrop-filter: blur(2px);\n}\n\n.dialog-content {\n    position: relative;\n    padding: 1.75rem;\n}\n\n.dialog-close {\n    position: absolute;\n    top: 1rem;\n    right: 1rem;\n    background: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-secondary);\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 10;\n}\n\n.dialog-close:hover {\n    color: var(--text-primary);\n    border-color: var(--text-muted);\n}\n\n.dialog-header-meta {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    margin-bottom: 0.4rem;\n}\n\n.dialog-title {\n    font-size: 1.5rem;\n    font-weight: 800;\n    line-height: 1.25;\n    margin-bottom: 0.2rem;\n}\n\n.dialog-artist {\n    color: var(--text-secondary);\n    font-size: 0.9rem;\n    margin-bottom: 0.85rem;\n}\n\n.dialog-description {\n    color: var(--text-secondary);\n    font-size: 0.875rem;\n    line-height: 1.6;\n    margin-bottom: 1.1rem;\n    background-color: var(--bg-elevated);\n    padding: 0.85rem 1rem;\n    border-radius: var(--radius-sm);\n    border-left: 3px solid var(--accent-red);\n}\n\n.dialog-info-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 0.75rem;\n    margin-bottom: 1.25rem;\n}\n\n.info-item {\n    background-color: var(--bg-elevated);\n    padding: 0.45rem 0.65rem;\n    border-radius: var(--radius-sm);\n    border: 1px solid var(--border-color);\n}\n\n.info-label {\n    font-size: 0.675rem;\n    color: var(--text-muted);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n}\n\n.info-value {\n    font-size: 0.825rem;\n    font-weight: 600;\n}\n\n/* Video Player Modal Styling */\n.video-dialog {\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    background-color: #121214;\n    color: var(--text-primary);\n    max-width: 960px;\n    width: 92%;\n    margin: auto;\n    padding: 0;\n    box-shadow: var(--shadow-dialog);\n    overflow: hidden;\n}\n\n.video-dialog::backdrop {\n    background-color: rgba(0, 0, 0, 0.85);\n    backdrop-filter: blur(4px);\n}\n\n.video-dialog-content {\n    position: relative;\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.video-modal-header {\n    display: flex;\n    flex-direction: column;\n    gap: 0.35rem;\n}\n\n.video-header-top {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n}\n\n.video-modal-title {\n    font-size: 1.5rem;\n    font-weight: 800;\n    color: var(--text-primary);\n    letter-spacing: -0.02em;\n}\n\n.video-wrapper {\n    width: 100%;\n    aspect-ratio: 16/9;\n    background-color: #000000;\n    border-radius: var(--radius-sm);\n    border: 1px solid var(--border-color);\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.video-wrapper video {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    background-color: #000000;\n    outline: none;\n}\n\n.video-modal-footer {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 0.75rem;\n    margin-top: 0.25rem;\n}\n\n/* Audio Player Bar */\n.audio-player-bar {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background-color: var(--bg-surface);\n    border-top: 1px solid var(--border-color);\n    padding: 0.65rem 1.5rem;\n    z-index: 90;\n    transition: transform 0.2s ease;\n}\n\n.audio-player-bar.minimized {\n    transform: translateY(calc(100% - 10px));\n}\n\n.player-container {\n    max-width: 1240px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 1rem;\n}\n\n.player-toggle-btn {\n    display: none;\n    background: none;\n    border: none;\n    color: var(--text-muted);\n    font-size: 0.8rem;\n    cursor: pointer;\n}\n\n.player-track-info {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    min-width: 220px;\n    max-width: 300px;\n}\n\n.track-thumb {\n    width: 38px;\n    height: 38px;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-sm);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.1rem;\n    flex-shrink: 0;\n}\n\n.track-text {\n    overflow: hidden;\n}\n\n.track-title {\n    font-size: 0.85rem;\n    font-weight: 600;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.track-artist {\n    font-size: 0.75rem;\n    color: var(--text-muted);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.player-controls {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n}\n\n.player-controls audio {\n    width: 100%;\n    max-width: 480px;\n    height: 36px;\n}\n\n.player-status {\n    display: flex;\n    align-items: center;\n    gap: 0.35rem;\n    font-size: 0.725rem;\n    color: var(--text-muted);\n    min-width: 140px;\n    justify-content: flex-end;\n}\n\n.event-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background-color: var(--text-muted);\n}\n\n.event-dot.active {\n    background-color: var(--accent-red);\n    box-shadow: 0 0 6px var(--accent-red);\n}\n\n/* Responsive Styles for Tablet and Mobile */\n@media (max-width: 900px) {\n    .benefits-grid, .steps-grid, .checkout-grid {\n        grid-template-columns: repeat(1, 1fr);\n    }\n}\n\n@media (max-width: 768px) {\n    .nav-container {\n        flex-wrap: wrap;\n        padding: 0.65rem 1rem;\n    }\n\n    .brand-logo-img {\n        height: 38px;\n    }\n\n    .landing-hero {\n        min-height: auto;\n        padding: 3.5rem 1rem 4rem 1rem;\n    }\n\n    .landing-hero-title {\n        font-size: 2.1rem;\n    }\n\n    .landing-hero-subtitle {\n        font-size: 1.15rem;\n    }\n\n    .input-action-group {\n        flex-direction: column;\n    }\n\n    .btn-get-started {\n        width: 100%;\n    }\n\n    .hero-section {\n        padding: 1.5rem 1.25rem;\n    }\n\n    .hero-title {\n        font-size: 1.75rem;\n    }\n\n    .toolbar {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .search-box {\n        min-width: 100%;\n    }\n\n    .filter-group {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .type-tabs {\n        justify-content: center;\n    }\n\n    .select-wrapper select {\n        width: 100%;\n    }\n\n    .video-dialog {\n        width: 96%;\n    }\n\n    .video-dialog-content {\n        padding: 1rem;\n    }\n\n    .video-modal-title {\n        font-size: 1.2rem;\n    }\n\n    .player-toggle-btn {\n        display: block;\n    }\n\n    .player-container {\n        flex-direction: column;\n        align-items: stretch;\n        gap: 0.4rem;\n    }\n\n    .player-track-info {\n        max-width: 100%;\n    }\n\n    .player-status {\n        justify-content: flex-start;\n    }\n\n    .member-nav-controls {\n        width: 100%;\n        justify-content: space-between;\n        margin-top: 0.5rem;\n    }\n}\n","Description":