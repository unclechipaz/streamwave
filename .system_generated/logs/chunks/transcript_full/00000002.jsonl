{"step_index":86,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-25T15:36:23Z","thinking":"**Refining Test Configuration**\n\nI'm currently focused on enhancing the test setup. I'm modifying `tests/test_api.py` to incorporate `sys.path` resolution at the beginning of the file. This ensures proper import paths for all test runner files, improving their portability.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import os\nimport sys\nfrom pathlib import Path\n\n# Ensure root project directory is on sys.path for test runner imports\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\nif str(PROJECT_ROOT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom app import app\n\nclient = TestClient(app)\n\n\ndef test_health_endpoint():\n    \"\"\"Tests GET /api/health returns 200 OK and expected serverless metadata.\"\"\"\n    response = client.get(\"/api/health\")\n    assert response.status_code == 200\n    data = response.json()\n    assert data[\"status\"] == \"ok\"\n    assert \"StreamWave\" in data[\"platform\"]\n    assert \"environment\" in data\n    assert \"blob_storage_configured\" in data\n    assert \"timestamp\" in data\n\n\ndef test_get_complete_media_catalogue():\n    \"\"\"Tests GET /api/media returns full catalogue array with local fallback media URLs.\"\"\"\n    response = client.get(\"/api/media\")\n    assert response.status_code == 200\n    items = response.json()\n    assert isinstance(items, list)\n    assert len(items) == 8\n    for item in items:\n        assert \"id\" in item\n        assert \"title\" in item\n        assert \"type\" in item\n        assert \"genre\" in item\n        assert \"media_url\" in item\n\n\ndef test_vercel_blob_url_environment_injection(monkeypatch):\n    \"\"\"Tests that setting STREAMWAVE_BLOB_URL injects Vercel Blob storage URL into media items.\"\"\"\n    test_blob_url = \"https://public.blob.vercel-storage.com/demo-test-123.wav\"\n    monkeypatch.setenv(\"STREAMWAVE_BLOB_URL\", test_blob_url)\n\n    response = client.get(\"/api/media/1\")\n    assert response.status_code == 200\n    item = response.json()\n    assert item[\"media_url\"] == test_blob_url\n\n    health_res = client.get(\"/api/health\")\n    assert health_res.json()[\"blob_storage_configured\"] is True\n\n\ndef test_local_fallback_when_no_blob_env(monkeypatch):\n    \"\"\"Tests clean fallback to /media/demo.wav when no Blob environment variable is set.\"\"\"\n    monkeypatch.delenv(\"STREAMWAVE_BLOB_URL\", raising=False)\n    monkeypatch.delenv(\"VERCEL_BLOB_AUDIO_URL\", raising=False)\n\n    response = client.get(\"/api/media/1\")\n    assert response.status_code == 200\n    item = response.json()\n    assert item[\"media_url\"] == \"/media/demo.wav\"\n\n\ndef test_media_search_filter_stream():\n    \"\"\"Tests GET /api/media with query=stream.\"\"\"\n    response = client.get(\"/api/media?query=stream\")\n    assert response.status_code == 200\n    items = response.json()\n    assert len(items) > 0\n    assert any(\"stream\" in item[\"description\"].lower() for item in items)\n\n\ndef test_media_type_filter_music():\n    \"\"\"Tests GET /api/media with type=music.\"\"\"\n    music_res = client.get(\"/api/media?type=music\")\n    assert music_res.status_code == 200\n    music = music_res.json()\n    assert len(music) == 4\n    assert all(item[\"type\"] == \"music\" for item in music)\n\n\ndef test_media_genre_filter():\n    \"\"\"Tests GET /api/media with genre filter.\"\"\"\n    response = client.get(\"/api/media?genre=Zimdancehall\")\n    assert response.status_code == 200\n    items = response.json()\n    assert len(items) > 0\n    assert all(item[\"genre\"] == \"Zimdancehall\" for item in items)\n\n\ndef test_get_valid_media_detail_id_1():\n    \"\"\"Tests GET /api/media/1 returns media item detail for ID 1.\"\"\"\n    response = client.get(\"/api/media/1\")\n    assert response.status_code == 200\n    item = response.json()\n    assert item[\"id\"] == \"1\"\n    assert item[\"title\"] == \"Cook Off\"\n    assert item[\"type\"] == \"movie\"\n\n\ndef test_get_unknown_media_detail_404():\n    \"\"\"Tests GET /api/media/{media_id} returns 404 for unknown ID.\"\"\"\n    response = client.get(\"/api/media/unknown-id-9999\")\n    assert response.status_code == 404\n    data = response.json()\n    assert data[\"detail\"] == \"Media item not found\"\n\n\ndef test_valid_play_event():\n    \"\"\"Tests POST /api/play-events with valid media ID.\"\"\"\n    payload = {\n        \"media_id\": \"1\",\n        \"session_id\": \"sess-test-123\",\n        \"client_timestamp\": \"2026-08-25T17:25:30Z\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 201\n    data = response.json()\n    assert data[\"status\"] == \"recorded\"\n    assert data[\"event\"][\"media_id\"] == \"1\"\n    assert data[\"event\"][\"media_title\"] == \"Cook Off\"\n    assert \"media_url_used\" in data[\"event\"]\n    assert \"server_timestamp\" in data[\"event\"]\n\n\ndef test_play_event_unknown_media_404():\n    \"\"\"Tests POST /api/play-events returns 404 for non-existent media ID.\"\"\"\n    payload = {\n        \"media_id\": \"nonexistent-media-999\",\n        \"session_id\": \"sess-test-456\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 404\n    data = response.json()\n    assert data[\"detail\"] == \"Media item not found\"\n\n\ndef test_play_event_invalid_body_422():\n    \"\"\"Tests POST /api/play-events returns 422 for missing required fields.\"\"\"\n    payload = {\n        \"session_id\": \"sess-test-789\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 422\n","Description":"Add explicit sys.path project root resolution in test_api.py to fix ModuleNotFoundError: No module named app","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\tests\\test_api.py","toolAction":"Updating test_api.py with sys.path resolution","toolSummary":"Updating test_api.py with sys.path resolution"}}]}
