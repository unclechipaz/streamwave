"\n    response = client.get(\"/api/media/unknown-id-9999\")\n    assert response.status_code == 404\n    data = response.json()\n    assert data[\"detail\"] == \"Media item not found\"\n\n\ndef test_valid_play_event():\n    \"\"\"Tests POST /api/play-events with valid media ID.\"\"\"\n    payload = {\n        \"media_id\": \"mov-001\",\n        \"session_id\": \"sess-test-123\",\n        \"client_timestamp\": \"2026-08-25T17:25:30Z\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 201\n    data = response.json()\n    assert data[\"status\"] == \"recorded\"\n    assert data[\"event\"][\"media_id\"] == \"mov-001\"\n    assert data[\"event\"][\"media_title\"] == \"Cook Off\"\n    assert \"server_timestamp\" in data[\"event\"]\n\n\ndef test_play_event_unknown_media_404():\n    \"\"\"Tests POST /api/play-events returns 404 for non-existent media ID.\"\"\"\n    payload = {\n        \"media_id\": \"nonexistent-media-999\",\n        \"session_id\": \"sess-test-456\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 404\n    data = response.json()\n    assert data[\"detail\"] == \"Media item not found\"\n\n\ndef test_play_event_invalid_body_422():\n    \"\"\"Tests POST /api/play-events returns 422 for missing required fields.\"\"\"\n    payload = {\n        \"session_id\": \"sess-test-789\",\n    }\n    response = client.post(\"/api/play-events\", json=payload)\n    assert response.status_code == 422\n","Description":"Create tests/test_api.py covering all API endpoints and validation cases","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\tests\\test_api.py","toolAction":"Creating tests/test_api.py","toolSummary":"Creating tests/test_api.py"}}]}
