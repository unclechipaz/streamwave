nse = client.get(\"/api/media/unknown-id-9999\")\n131:     assert response.status_code == 404\n132:     data = response.json()\n133:     assert data[\"detail\"] == \"Media item not found\"\n134: \n135: \n136: def test_valid_play_event_movie():\n137:     \"\"\"Tests POST /api/play-events with valid movie media ID.\"\"\"\n138:     payload = {\n139:         \"media_id\": \"1\",\n140:         \"session_id\": \"sess-test-123\",\n141:         \"client_timestamp\": \"2026-08-25T17:25:30Z\",\n142:     }\n143:     response = client.post(\"/api/play-events\", json=payload)\n144:     assert response.status_code == 201\n145:     data = response.json()\n146:     assert data[\"status\"] == \"recorded\"\n147:     assert data[\"event\"][\"media_id\"] == \"1\"\n148:     assert data[\"event\"][\"media_title\"] == \"Cook Off\"\n149:     assert \"media_url_used\" in data[\"event\"]\n150:     assert \"server_timestamp\" in data[\"event\"]\n151: \n152: \n153: def test_play_event_unknown_media_404():\n154:     \"\"\"Tests POST /api/play-events returns 404 for non-existent media ID.\"\"\"\n155:     payload = {\n156:         \"media_id\": \"nonexistent-media-999\",\n157:         \"session_id\": \"sess-test-456\",\n158:     }\n159:     response = client.post(\"/api/play-events\", json=payload)\n160:     assert response.status_code == 404\n161:     data = response.json()\n162:     assert data[\"detail\"] == \"Media item not found\"\n163: \n164: \n165: def test_play_event_invalid_body_422():\n166:     \"\"\"Tests POST /api/play-events returns 422 for missing required fields.\"\"\"\n167:     payload = {\n168:         \"session_id\": \"sess-test-789\",\n169:     }\n170:     response = client.post(\"/api/play-events\", json=payload)\n171:     assert response.status_code == 422\n172: \nThe above content shows the entire, complete file contents of the requested file.\n"}
