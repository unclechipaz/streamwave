{"step_index":186,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-25T19:07:45Z","content":"Created At: 2026-08-25T21:07:45+02:00\nCompleted At: 2026-08-25T21:07:45+02:00\nFile Path: `file:///C:/Users/dell/.gemini/antigravity/brain/228fe0bc-0a77-489e-a1ba-57d617247457/app.py`\nTotal Lines: 301\nTotal Bytes: 10955\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import json\n2: import logging\n3: import os\n4: import shutil\n5: from datetime import datetime, timezone\n6: from pathlib import Path\n7: from typing import List, Optional\n8: \n9: from fastapi import FastAPI, HTTPException, Path as PathParam, Query, Request, status\n10: from fastapi.staticfiles import StaticFiles\n11: from pydantic import BaseModel, Field\n12: \n13: # Configure structured Python logger\n14: logging.basicConfig(\n15:     level=logging.INFO, format=\"%(asctime)s [%(levelname)s] %(name)s: %(message)s\"\n16: )\n17: logger = logging.getLogger(\"streamwave\")\n18: \n19: BASE_DIR = Path(__file__).resolve().parent\n20: DATA_FILE = BASE_DIR / \"data\" / \"media.json\"\n21: PUBLIC_DIR = BASE_DIR / \"public\"\n22: MEDIA_DIR = PUBLIC_DIR / \"media\"\n23: IMAGES_DIR = PUBLIC_DIR / \"images\"\n24: \n25: PREVIEW_VIDEO_FILE = MEDIA_DIR / \"streamwave-preview.mp4\"\n26: LOGO_IMAGE_FILE = IMAGES_DIR / \"streamwave-logo.png\"\n27: \n28: \n29: # Ensure video preview asset is available in public/media/\n30: def ensure_video_preview_asset():\n31:     MEDIA_DIR.mkdir(parents=True, exist_ok=True)\n32:     if not PREVIEW_VIDEO_FILE.exists() or PREVIEW_VIDEO_FILE.stat().st_size == 0:\n33:         downloads_dir = Path(r\"C:\\Users\\dell\\Downloads\")\n34:         candidate_sources = [\n35:             downloads_dir / \"Use_the_uploaded_StreamWave_lo.mp4\",\n36:             downloads_dir / \"Download (28).mp4\",\n37:         ]\n38:         for src in candidate_sources:\n39:             if src.exists() and src.stat().st_size > 0:\n40:                 try:\n41:                     shutil.copyfile(src, PREVIEW_VIDEO_FILE)\n42:                     logger.info(f\"Copied StreamWave preview MP4 video from {src} to {PREVIEW_VIDEO_FILE}\")\n43:                     break\n44:                 except Exception as e:\n45:                     logger.error(f\"Failed to copy video asset from {src}: {e}\")\n46: \n47: # Ensure logo image asset is available in public/images/\n48: def ensure_logo_asset():\n49:     IMAGES_DIR.mkdir(parents=True, exist_ok=True)\n50:     if not LOGO_IMAGE_FILE.exists() or LOGO_IMAGE_FILE.stat().st_size == 0:\n51:         src = BASE_DIR / \".user_uploaded\" / \"media_1787682860034.png\"\n52:         if not src.exists():\n53:             src = BASE_DIR / \".user_uploaded\" / \"media_1787683482860.png\"\n54:         if src.exists() and src.stat().st_size > 0:\n55:             try:\n56:                 shutil.copyfile(src, LOGO_IMAGE_FILE)\n57:                 logger.info(f\"Copied StreamWave logo image from {src} to {LOGO_IMAGE_FILE}\")\n58:             except Exception as e:\n59:                 logger.error(f\"Failed to copy logo image: {e}\")\n60: \n61: # Ensure browser tab favicons are generated from logo\n62: def ensure_favicon_assets():\n63:     if LOGO_IMAGE_FILE.exists():\n64:         favicon_png = IMAGES_DIR / \"favicon.png\"\n65:         favicon_ico = PUBLIC_DIR / \"favicon.ico\"\n66:         try:\n67:             if not favicon_png.exists():\n68:                 shutil.copyfile(LOGO_IMAGE_FILE, favicon_png)\n69:             if not favicon_ico.exists():\n70:                 shutil.copyfile(LOGO_IMAGE_FILE, favicon_ico)\n71:         except Exception as e:\n72:             logger.error(f\"Failed to copy favicon: {e}\")\n73: \n74: ensure_video_preview_asset()\n75: ensure_logo_asset()\n76: ensure_favicon_assets()\n77: \n78: # Vercel Blob Audio URL Environment Variable with local static fallback\n79: DEFAULT_FALLBACK_AUDIO_URL = \"/media/demo.wav\"\n80: BLOB_AUDIO_URL_ENV = os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\")\n81: \n82: if BLOB_AUDIO_URL_ENV:\n83:     logger.info(\"Vercel Blob Storage active for demonstration audio assets.\")\n84: else:\n85:     logger.info(f\"No Vercel Blob URL configured. Using local fallback: {DEFAULT_FALLBACK_AUDIO_URL}\")\n86: \n87: \n88: def load_media_catalogue() -> List[dict]:\n89:     \"\"\"\n90:     Loads read-only media catalogue from data/media.json using pathlib.\n91:     Dynamically injects configured Vercel Blob URL for demonstration audio\n92:     if STREAMWAVE_BLOB_URL or VERCEL_BLOB_AUDIO_URL environment variable is set,\n93:     otherwise cleanly falls back to local static asset /media/demo.wav.\n94:     \"\"\"\n95:     if not DATA_FILE.exists():\n96:         logger.error(f\"Media catalogue file not found at {DATA_FILE}\")\n97:         return []\n98: \n99:     with open(DATA_FILE, \"r\", encoding=\"utf-8\") as f:\n100:         catalogue = json.load(f)\n101: \n102:     # Check for active Vercel Blob URL in environment\n103:     active_blob_url = os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\")\n104: \n105:     for item in catalogue:\n106:         # If item relies on demo audio, replace with Vercel Blob URL if available\n107:         if item.get(\"type\") == \"music\" and item.get(\"media_url\") == DEFAULT_FALLBACK_AUDIO_URL and active_blob_url:\n108:             item[\"media_url\"] = active_blob_url.strip()\n109: \n110:     return catalogue\n111: \n112: \n113: # --- Pydantic Validation Models ---\n114: \n115: \n116: class HealthResponse(BaseModel):\n117:     status: str = Field(..., json_schema_extra={\"example\": \"ok\"})\n118:     platform: str = Field(..., json_schema_extra={\"example\": \"StreamWave Serverless Media Platform\"})\n119:     environment: str = Field(..., json_schema_extra={\"example\": \"Vercel Serverless\"})\n120:     blob_storage_configured: bool = Field(..., json_schema_extra={\"example\": False})\n121:     timestamp: str = Field(..., json_schema_extra={\"example\": \"2026-08-25T17:25:30Z\"})\n122: \n123: \n124: class MediaItem(BaseModel):\n125:     id: str = Field(..., json_schema_extra={\"example\": \"1\"})\n126:     title: str = Field(..., json_schema_extra={\"example\": \"Cook Off\"})\n127:     artist_or_director: str = Field(..., json_schema_extra={\"example\": \"Tomas Brickhill\"})\n128:     type: str = Field(..., json_schema_extra={\"example\": \"movie\"})\n129:     genre: str = Field(..., json_schema_extra={\"example\": \"Comedy\"})\n130:     year: int = Field(..., json_schema_extra={\"example\": 2017})\n131:     duration: str = Field(..., json_schema_extra={\"example\": \"1h 41m\"})\n132:     description: str = Field(...)\n133:     cover_image: Optional[str] = None\n134:     media_url: Optional[str] = None\n135:     preview_url: Optional[str] = None\n136: \n137: \n138: class PlayEventRequest(BaseModel):\n139:     media_id: str = Field(..., min_length=1, max_length=50)\n140:     session_id: Optional[str] = Field(default=None, max_length=100)\n141:     client_timestamp: Optional[str] = Field(default=None, max_length=100)\n142: \n143: \n144: class PlayEventDetail(BaseModel):\n145:     media_id: str\n146:     session_id: Optional[str] = None\n147:     client_timestamp: Optional[str] = None\n148:     server_timestamp: str\n149:     media_title: str\n150:     media_url_used: Optional[str] = None\n151: \n152: \n153: class PlayEventResponse(BaseModel):\n154:     status: str = \"recorded\"\n155:     event: PlayEventDetail\n156: \n157: \n158: # --- FastAPI Application ---\n159: \n160: app = FastAPI(\n161:     title=\"StreamWave Serverless Media Platform API\",\n162:     description=\"FastAPI Backend for StreamWave Entertainment with Vercel Blob & MP4 Video Preview Integration\",\n163:     version=\"1.2.0\",\n164:     docs_url=\"/docs\",\n165:     redoc_url=\"/redoc\",\n166: )\n167: \n168: \n169: # Security Response Headers Middleware\n170: @app.middleware(\"http\")\n171: async def add_security_headers(request: Request, call_next):\n172:     response = await call_next(request)\n173:     response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n174:     response.headers[\"X-Frame-Options\"] = \"DENY\"\n175:     response.headers[\"X-XSS-Protection\"] = \"1; mode=block\"\n176:     response.headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n177:     return response\n178: \n179: \n180: # --- API Routes (Registered BEFORE Static File Mounting) ---\n181: \n182: \n183: @app.get(\"/api/health\", response_model=HealthResponse, tags=[\"Health\"])\n184: async def get_health():\n185:     \"\"\"Returns platform health status, Vercel Blob configuration status, and serverless environment info.\"\"\"\n186:     active_blob = bool(os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\"))\n187:     return HealthResponse(\n188:         status=\"ok\",\n189:         platform=\"StreamWave Serverless Media Platform\",\n190:         environment=\"Vercel Serverless\",\n191:         blob_storage_configured=active_blob,\n192:         timestamp=datetime.now(timezone.utc).isoformat(),\n193:     )\n194: \n195: \n196: @app.get(\"/api/media\", response_model=List[MediaItem], tags=[\"Media\"])\n197: async def get_media(\n198:     query: Optional[str] = Query(default=None, max_length=100),\n199:     type: Optional[str] = Query(default=None, max_length=20),\n200:     genre: Optional[str] = Query(default=None, max_length=50),\n201: ):\n202:     \"\"\"Retrieves media catalogue with optional search query, type, and genre filters.\"\"\"\n203:     catalogue = load_media_catalogue()\n204:     results = catalogue\n205: \n206:     if type:\n207:         target_type = type.strip().lower()\n208:         results = [\n209:             item for item in results if item.get(\"type\", \"\").lower() == target_type\n210:         ]\n211: \n212:     if genre:\n213:         target_genre = genre.strip().lower()\n214:         results = [\n215:             item for item in results if item.get(\"genre\", \"\").lower() == target_genre\n216:         ]\n217: \n218:     if query:\n219:         q = query.strip().lower()\n220:         results = [\n221:             item\n222:             for item in results\n223:             if q in item.get(\"title\", \"\").lower()\n224:             or q in item.get(\"artist_or_director\", \"\").lower()\n225:             or q in item.get(\"description\", \"\").lower()\n226:             or q in item.get(\"genre\", \"\").lower()\n227:         ]\n228: \n229:     return results\n230: \n231: \n232: @app.get(\"/api/media/{media_id}\", response_model=MediaItem, tags=[\"Media\"])\n233: async def get_media_detail(media_id: str = PathParam(..., max_length=50)):\n234:     \"\"\"Retrieves single media item by ID or returns HTTP 404.\"\"\"\n235:     catalogue = load_media_catalogue()\n236:     for item in catalogue:\n237:         if item.get(\"id\") == media_id:\n238:             return item\n239:     raise HTTPException(\n240:         status_code=status.HTTP_404_NOT_FOUND,\n241:         detail=\"Media item not found\",\n242:     )\n243: \n244: \n245: @app.post(\n246:     \"/api/play-events\",\n247:     response_model=PlayEventResponse,\n248:     status_code=status.HTTP_201_CREATED,\n249:     tags=[\"Playback Events\"],\n250: )\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
