{"step_index":190,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-25T19:08:19Z","content":"Created At: 2026-08-25T21:08:19+02:00\nCompleted At: 2026-08-25T21:08:19+02:00\nFile Path: `file:///C:/Users/dell/.gemini/antigravity/brain/228fe0bc-0a77-489e-a1ba-57d617247457/tests/test_api.py`\nTotal Lines: 172\nTotal Bytes: 5982\nShowing lines 1 to 172\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import os\n2: import sys\n3: from pathlib import Path\n4: \n5: # Ensure root project directory is on sys.path for test runner imports\n6: PROJECT_ROOT = Path(__file__).resolve().parent.parent\n7: if str(PROJECT_ROOT) not in sys.path:\n8:     sys.path.insert(0, str(PROJECT_ROOT))\n9: \n10: import pytest\n11: from fastapi.testclient import TestClient\n12: from app import app\n13: \n14: client = TestClient(app)\n15: \n16: \n17: def test_health_endpoint():\n18:     \"\"\"Tests GET /api/health returns 200 OK and expected serverless metadata.\"\"\"\n19:     response = client.get(\"/api/health\")\n20:     assert response.status_code == 200\n21:     data = response.json()\n22:     assert data[\"status\"] == \"ok\"\n23:     assert \"StreamWave\" in data[\"platform\"]\n24:     assert \"environment\" in data\n25:     assert \"blob_storage_configured\" in data\n26:     assert \"timestamp\" in data\n27: \n28: \n29: def test_get_complete_media_catalogue():\n30:     \"\"\"Tests GET /api/media returns full catalogue array with movie video previews and music URLs.\"\"\"\n31:     response = client.get(\"/api/media\")\n32:     assert response.status_code == 200\n33:     items = response.json()\n34:     assert isinstance(items, list)\n35:     assert len(items) == 8\n36:     for item in items:\n37:         assert \"id\" in item\n38:         assert \"title\" in item\n39:         assert \"type\" in item\n40:         assert \"genre\" in item\n41:         assert \"media_url\" in item\n42:         if item[\"type\"] == \"movie\":\n43:             assert item[\"preview_url\"] == \"/media/streamwave-preview.mp4\"\n44: \n45: \n46: def test_movie_preview_url_field():\n47:     \"\"\"Tests GET /api/media/1 (Cook Off movie) returns preview_url pointing to /media/streamwave-preview.mp4.\"\"\"\n48:     response = client.get(\"/api/media/1\")\n49:     assert response.status_code == 200\n50:     item = response.json()\n51:     assert item[\"id\"] == \"1\"\n52:     assert item[\"type\"] == \"movie\"\n53:     assert item[\"preview_url\"] == \"/media/streamwave-preview.mp4\"\n54: \n55: \n56: def test_vercel_blob_url_environment_injection(monkeypatch):\n57:     \"\"\"Tests that setting STREAMWAVE_BLOB_URL injects Vercel Blob storage URL into music items.\"\"\"\n58:     test_blob_url = \"https://public.blob.vercel-storage.com/demo-test-123.wav\"\n59:     monkeypatch.setenv(\"STREAMWAVE_BLOB_URL\", test_blob_url)\n60: \n61:     response = client.get(\"/api/media/5\")  # Disappear (music)\n62:     assert response.status_code == 200\n63:     item = response.json()\n64:     assert item[\"media_url\"] == test_blob_url\n65: \n66:     health_res = client.get(\"/api/health\")\n67:     assert health_res.json()[\"blob_storage_configured\"] is True\n68: \n69: \n70: def test_local_fallback_when_no_blob_env(monkeypatch):\n71:     \"\"\"Tests clean fallback to /media/demo.wav for music when no Blob environment variable is set.\"\"\"\n72:     monkeypatch.delenv(\"STREAMWAVE_BLOB_URL\", raising=False)\n73:     monkeypatch.delenv(\"VERCEL_BLOB_AUDIO_URL\", raising=False)\n74: \n75:     response = client.get(\"/api/media/5\")  # Disappear (music)\n76:     assert response.status_code == 200\n77:     item = response.json()\n78:     assert item[\"media_url\"] == \"/media/demo.wav\"\n79: \n80: \n81: def test_media_search_filter_stream():\n82:     \"\"\"Tests GET /api/media with query