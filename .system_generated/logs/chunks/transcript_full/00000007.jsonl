em.get(\"title\", \"\"),\n285:                 \"media_type\": media_item.get(\"type\", \"unknown\"),\n286:                 \"media_url\": media_url,\n287:                 \"session_id\": payload.session_id,\n288:                 \"client_timestamp\": payload.client_timestamp,\n289:                 \"server_timestamp\": server_ts,\n290:             }\n291:         )\n292:     )\n293: \n294:     return PlayEventResponse(status=\"recorded\", event=event_detail)\n295: \n296: \n297: # --- Static Files Mounting for Local & Production Serving ---\n298: \n299: if PUBLIC_DIR.exists():\n300:     app.mount(\"/\", StaticFiles(directory=str(PUBLIC_DIR), html=True), name=\"public\")\n301: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
