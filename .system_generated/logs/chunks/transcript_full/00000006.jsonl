   .select-wrapper select {\n        width: 100%;\n    }\n\n    .video-dialog {\n        width: 96%;\n    }\n\n    .video-dialog-content {\n        padding: 1rem;\n    }\n\n    .video-modal-title {\n        font-size: 1.2rem;\n    }\n\n    .player-toggle-btn {\n        display: block;\n    }\n\n    .player-container {\n        flex-direction: column;\n        align-items: stretch;\n        gap: 0.4rem;\n    }\n\n    .player-track-info {\n        max-width: 100%;\n    }\n\n    .player-status {\n        justify-content: flex-start;\n    }\n\n    body {\n        padding-bottom: 140px;\n    }\n}\n","Description":"Add Netflix-style landing hero and Auth dialog modal styles in public/css/styles.css","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\public\\css\\styles.css","toolAction":"Updating public/css/styles.css with landing hero styles","toolSummary":"Updating public/css/styles.css with landing hero styles"}}]}
