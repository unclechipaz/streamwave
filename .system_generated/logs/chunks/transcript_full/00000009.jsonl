21:     event: PlayEventDetail\n222: \n223: \n224: class DemoPaymentRequest(BaseModel):\n225:     email: str = Field(..., json_schema_extra={\"example\": \"customer@example.co.zw\"})\n226:     method: str = Field(..., json_schema_extra={\"example\": \"ecocash\"})  # ecocash, visa, mastercard\n227:     plan_id: Optional[str] = Field(default=\"streamwave-monthly\", json_schema_extra={\"example\": \"streamwave-monthly\"})\n228: \n229: \n230: class DemoPaymentResponse(BaseModel):\n231:     status: str = \"approved\"\n232:     tx_ref: str\n233:     email: str\n234:     method: str\n235:     plan: dict\n236:     redirect_url: str = \"/library\"\n237: \n238: \n239: class SessionInfoResponse(BaseModel):\n240:     authenticated: bool\n241:     email: Optional[str] = None\n242:     plan: Optional[dict] = None\n243: \n244: \n245: # --- FastAPI Application ---\n246: \n247: app = FastAPI(\n248:     title=\"StreamWave Serverless Media Platform API\",\n249:     description=\"FastAPI Backend for StreamWave Entertainment with Academic Payment Simulation & Session Access Control\",\n250:     version=\"2.0.0\",\n251:     docs_url=\"/docs\",\n252:     redoc_url=\"/redoc\",\n253: )\n254: \n255: \n256: # Security Response Headers Middleware\n257: @app.middleware(\"http\")\n258: async def add_security_headers(request: Request, call_next):\n259:     response = await call_next(request)\n260:     response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n261:     response.headers[\"X-Frame-Options\"] = \"DENY\"\n262:     response.headers[\"X-XSS-Protection\"] = \"1; mode=block\"\n263:     response.headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\"\n264:     return response\n265: \n266: \n267: # --- Public HTML Page Routes ---\n268: \n269: @app.get(\"/\", response_class=FileResponse, include_in_schema=False)\n270: async def serve_landing_page():\n271:     \"\"\"Serves the public StreamWave landing page.\"\"\"\n272:     landing_file = PUBLIC_DIR / \"index.html\"\n273:     if landing_file.exists():\n274:         return FileResponse(str(landing_file))\n275:     raise HTTPException(status_code=404, detail=\"Landing page not found\")\n276: \n277: \n278: @app.get(\"/checkout\", response_class=FileResponse, include_in_schema=False)\n279: async def serve_checkout_page():\n280:     \"\"\"Serves the simulated academic checkout page.\"\"\"\n281:     checkout_file = PUBLIC_DIR / \"checkout.html\"\n282:     if checkout_file.exists():\n283:         return FileResponse(str(checkout_file))\n284:     raise HTTPException(status_code=404, detail=\"Checkout page not found\")\n285: \n286: \n287: @app.get(\"/library\", response_class=FileResponse, include_in_schema=False)\n288: async def serve_library_page():\n289:     \"\"\"Serves the paid member catalogue library page.\"\"\"\n290:     library_file = PUBLIC_DIR / \"library.html\"\n291:     if library_file.exists():\n292:         return FileResponse(str(library_file))\n293:     raise HTTPException(status_code=404, detail=\"Library page not found\")\n294: \n295: \n296: # --- Public API Routes ---\n297: \n298: @app.get(\"/api/health\", response_model=HealthResponse, tags=[\"Health\"])\n299: async def get_health():\n300:     \"\"\"Returns platform health status, Vercel Blob configuration status, and serverless environment info.\"\"\"\n301:     active_blob = bool(os.getenv(\"STREAMWAVE_BLOB_URL\") or os.getenv(\"VERCEL_BLOB_AUDIO_URL\"))\n302:     return HealthResponse(\n303:         status=\"ok\",\n304:         platform=\"StreamWave Serverless Media Platform\",\n305:         environment=\"Vercel Serverless\",\n306:         blob_storage_configured=active_blob,\n307:         timestamp=datetime.now(timezone.utc).isoformat(),\n308:     )\n309: \n310: \n311: @app.get(\"/api/session\", response_model=SessionInfoResponse, tags=[\"Session\"])\n312: async def get_session(request: Request):\n313:     \"\"\"Checks the active demo-paid member session status from signed HTTP-only cookie.\"\"\"\n314:     token = request.cookies.get(\"streamwave_session\")\n315:     session_data = verify_session_token(token) if token else None\n316:     if session_data:\n317:         return SessionInfoResponse(\n318:             authenticated=True,\n319:             email=session_data.get(\"email\"),\n320:             plan=SUBSCRIPTION_PLAN,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":220,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-25T19:14:00Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"#!/usr/bin/env python3\n\"\"\"\nExecutes pytest test suite programmatically and prints test results.\n\"\"\"\n\nimport sys\nfrom pathlib import Path\n\nPROJECT_ROOT = Path(__file__).resolve().parent.parent\nif str(PROJECT_ROOT) not in sys.path:\n    sys.path.insert(0, str(PROJECT_ROOT))\n\nimport pytest\n\ndef main():\n    print(\"=\" * 60)\n    print(\"Running StreamWave Automated Pytest Test Suite...\")\n    print(\"=\" * 60)\n    exit_code = pytest.main([\"tests/test_api.py\", \"-v\", \"--tb=short\"])\n    print(\"=\" * 60)\n    if exit_code == 0:\n        print(\"✅ ALL AUTOMATED TESTS PASSED (100% SUCCESS RATE)\")\n    else:\n        print(f\"❌ TEST SUITE FAILED (Exit Code: {exit_code})\")\n    print(\"=\" * 60)\n    return exit_code\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","Description":"Create script to run pytest test suite programmatically","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\scripts\\run_tests.py","toolAction":"Creating test runner script","toolSummary":"Creating test runner script"}}]}
