                </button>\n            </div>\n        `;\n\n        elements.detailsDialog.showModal();\n    }\n\n    /**\n     * Resets filter parameters\n     */\n    function resetFilters() {\n        state.searchQuery = '';\n        state.activeType = '';\n        state.activeGenre = '';\n        elements.searchInput.value = '';\n        elements.genreSelect.value = '';\n        elements.clearSearchBtn.style.display = 'none';\n        elements.typeTabs.forEach((tab, index) => {\n            tab.classList.toggle('active', index === 0);\n            tab.setAttribute('aria-selected', index === 0 ? 'true' : 'false');\n        });\n        fetchMedia();\n    }\n\n    /**\n     * Basic HTML escaping to prevent XSS\n     */\n    function escapeHtml(str) {\n        if (!str) return '';\n        return str\n            .replace(/&/g, '&amp;')\n            .replace(/</g, '&lt;')\n            .replace(/>/g, '&gt;')\n            .replace(/\"/g, '&quot;')\n            .replace(/'/g, '&#039;');\n    }\n\n    // Expose global methods for inline button onclick handlers\n    window.streamWaveApp = {\n        fetchMedia,\n        playMedia,\n        playMoviePreview,\n        openDetails,\n        closeVideoModal,\n        resetFilters\n    };\n\n    // Initialize on DOM load\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', init);\n    } else {\n        init();\n    }\n})();\n","Description":"Update public/js/app.js with movie video preview modal, keyboard focus management, single play event logging, replay button, and scroll locking","Overwrite":true,"TargetFile":"C:\\Users\\dell\\.gemini\\antigravity\\brain\\228fe0bc-0a77-489e-a1ba-57d617247457\\public\\js\\app.js","toolAction":"Updating public/js/app.js with video modal logic","toolSummary":"Updating public/js/app.js with video modal logic"}}]}
