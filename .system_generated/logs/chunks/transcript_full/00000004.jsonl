nline-flex;\n    align-items: center;\n    gap: 0.25rem;\n}\n\n.developer-link:hover {\n    background-color: rgba(229, 9, 20, 0.25);\n    color: #ffffff;\n}\n\n.ext-icon {\n    font-size: 0.75rem;\n}\n\n.serverless-badge-sm {\n    display: flex;\n    align-items: center;\n    gap: 0.35rem;\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    padding: 0.2rem 0.5rem;\n    border-radius: var(--radius-sm);\n    font-size: 0.7rem;\n    font-weight: 600;\n    color: var(--text-secondary);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n}\n\n.pulse-dot {\n    width: 6px;\n    height: 6px;\n    background-color: #10b981;\n    border-radius: 50%;\n}\n\n/* Main Container */\n.main-content {\n    max-width: 1240px;\n    width: 100%;\n    margin: 0 auto;\n    padding: 1.5rem;\n    flex: 1;\n}\n\n/* Hero / Featured Section */\n.hero-section {\n    position: relative;\n    background-color: var(--bg-surface);\n    border: 1px solid var(--border-color);\n    border-radius: var(--radius-md);\n    padding: 2.25rem 2rem;\n    margin-bottom: 2rem;\n    overflow: hidden;\n    background-image: linear-gradient(to right, rgba(24, 24, 28, 0.95) 45%, rgba(24, 24, 28, 0.65)), url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1200&q=80');\n    background-size: cover;\n    background-position: center;\n}\n\n.hero-content {\n    position: relative;\n    z-index: 2;\n    max-width: 620px;\n}\n\n.hero-tag-group {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    margin-bottom: 0.4rem;\n}\n\n.hero-tag {\n    color: var(--accent-red);\n    font-size: 0.725rem;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n}\n\n.tech-sample-pill {\n    background-color: var(--bg-elevated);\n    border: 1px solid var(--border-color);\n    color: var(--text-muted);\n    font-size: 0.675rem;\n    font-weight: 600;\n    padding: 0.1rem 0.4rem;\n    border-radius: var(--radi