     )\n260:     if not media_item:\n261:         raise HTTPException(\n262:             status_code=status.HTTP_404_NOT_FOUND,\n263:             detail=\"Media item not found\",\n264:         )\n265: \n266:     server_ts = datetime.now(timezone.utc).isoformat()\n267:     media_url = media_item.get(\"media_url\", DEFAULT_FALLBACK_AUDIO_URL)\n268: \n269:     event_detail = PlayEventDetail(\n270:         media_id=payload.media_id,\n271:         session_id=payload.session_id,\n272:         client_timestamp=payload.client_timestamp,\n273:         server_timestamp=server_ts,\n274:         media_title=media_item.get(\"title\", \"\"),\n275:         media_url_used=media_url,\n276:     )\n277: \n278:     # Log structured JSON playback event\n279:     logger.info(\n280:         json.dumps(\n281:             {\n282:                 \"event_type\": \"playback_started\",\n283:                 \"media_id\": payload.media_id,\n284:                 \"media_title\": media_item.get(\"title\", \"\"),\n285:                 \"media_type\": media_item.get(\"type\", \"unknown\"),\n286:                 \"media_url\": media_url,\n287:                 \"session_id\": payload.session_id,\n288:                 \"client_timestamp\": payload.client_timestamp,\n289:                 \"server_timestamp\": server_ts,\n290:             }\n291:         )\n292:     )\n293: \n294:     return PlayEventResponse(status=\"recorded\", event=event_detail)\n295: \n296: \n297: # --- Static Files Mounting for Local & Production Serving ---\n298: \n299: if PUBLIC_DIR.exists():\n300:     app.mount(\"/\", StaticFiles(directory=str(PUBLIC_DIR), html=True), name=\"public\")\n301: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
